model Subscription {
  id                     String              @id @default(cuid())
  studentId              String              @unique
  student                Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  plan                   SubscriptionPlan
  billingCycle           BillingCycle
  status                 SubscriptionStatus  @default(TRIAL)

  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime

  amount                 Float
  cancelAtPeriodEnd      Boolean             @default(false)
  pendingPlan            SubscriptionPlan?

  razorpaySubscriptionId String?             @unique
  razorpayOrderId        String?

  payments               SubscriptionPayment[]

  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([status])
  @@index([plan])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                     String                     @id @default(cuid())
  subscriptionId         String
  subscription           Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount                 Float
  status                 SubscriptionPaymentStatus @default(PENDING)
  method                 SubscriptionPaymentMethod @default(RAZORPAY)

  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  razorpaySignature      String?

  periodStart            DateTime?
  periodEnd              DateTime?
  failureReason          String?

  // Set once, when this payment is created at checkout (Order path only —
  // see SubscriptionError thrown in createCheckout() for recurring
  // MONTHLY). Redemption itself (bumping Coupon.redeemedCount) only
  // happens once the payment actually reaches SUCCESS, so an abandoned
  // checkout never consumes a limited-use code.
  couponId               String?
  coupon                 Coupon?                    @relation(fields: [couponId], references: [id])

  // Human-readable receipt number, assigned once (in
  // verifyAndActivateOrderPayment / grantSubscriptionManually / the
  // subscription.charged webhook handler) the moment a payment reaches
  // SUCCESS — never on PENDING/FAILED, so invoice numbers stay a gapless
  // record of money actually received. See generateInvoiceNumber().
  invoiceNumber          String?                    @unique

  refunds                Refund[]

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("subscription_payments")
}

model PlanPricing {
  id           String           @id @default(cuid())
  plan         SubscriptionPlan
  billingCycle BillingCycle
  amount       Float
  updatedAt    DateTime         @updatedAt
  updatedBy    String?

  @@unique([plan, billingCycle])
  @@map("plan_pricing")
}

enum CouponType {
  PERCENT
  FLAT
}

// Discount codes, applied at checkout for one-time (non-recurring) plans
// only — QUARTERLY / HALF_YEARLY / ANNUAL, whose full amount is computed
// upfront as a Razorpay Order. Recurring MONTHLY checkouts go through
// Razorpay Subscriptions instead, charged independently every cycle by
// Razorpay's own scheduler; discounting those correctly would mean either
// re-deriving the coupon on every future `subscription.charged` webhook
// or minting a separate discounted Razorpay Plan per coupon+student, both
// more machinery than this feature is worth right now — createCheckout()
// throws a clear, honest error rather than silently ignoring a coupon
// code on a MONTHLY checkout.
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  type           CouponType
  // PERCENT: 0-100. FLAT: a rupee amount, capped to the plan price so a
  // discount can never push the payable amount below zero.
  value          Float
  // null = valid against either plan.
  plan           SubscriptionPlan?
  // null = unlimited uses.
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments SubscriptionPayment[]

  @@index([isActive])
  @@map("coupons")
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

// One row per refund attempt on a SubscriptionPayment. Deliberately
// allows more than one Refund per payment (no unique constraint) rather
// than assuming full-refund-only — the Finance team's own judgment on
// whether a payment is "already refunded" reads the existing rows rather
// than this schema enforcing a single-refund rule that may not hold.
model Refund {
  id                    String       @id @default(cuid())
  subscriptionPaymentId String
  amount                Float
  reason                String?
  status                RefundStatus @default(PENDING)
  // Set only when actually processed through Razorpay's refund API
  // (method RAZORPAY on the original payment). A refund against an
  // OFFLINE payment has no gateway counterpart — it's a manual record of
  // money returned outside Razorpay (cash/UPI), same spirit as
  // grantSubscriptionManually() on the payment side.
  razorpayRefundId      String?
  processedById         String
  createdAt             DateTime     @default(now())

  payment SubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Cascade)

  @@index([subscriptionPaymentId])
  @@map("refunds")
}

enum LectureStatus {
  DRAFT
  PUBLISHED
}

// ----------------------------------------------------------------------------
// LECTURE LIBRARY — recorded video lectures, chapter-wise. A Chapter can have
// several Lecture "parts" (a mini-series, e.g. "Cell I Chapterwise"), ordered
// by `order` for the player's prev/next navigation. Deliberately NOT storing
// video duration: it's read client-side from the <video> element's real
// `duration` once loaded, so it can never drift from the actual file.
// Deliberately NOT storing multiple quality renditions: only one `videoUrl`
// per lecture — the player's "quality" menu is honest about this (see
// LecturePlayer.tsx) rather than faking a selector with no real alternate
// sources behind it.
// ----------------------------------------------------------------------------

model Lecture {
  id               String        @id @default(cuid())
  chapterId        String
  title            String
  language         String        @default("English")
  order            Int           @default(0)
  videoUrl         String        @default("")
  educatorVideoUrl String?
  slidesUrl        String?
  scheduledDate    DateTime?
  startTime        String?
  endTime          String?
  durationMin      Int?          @default(60)
  status           LectureStatus @default(DRAFT)
  teacherId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  chapter      Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher      Teacher              @relation(fields: [teacherId], references: [id])
  issueReports LectureIssueReport[]
  notes        LectureNote[]
  progress     LectureProgress[]

  @@index([chapterId])
  @@index([status])
  @@map("lectures")
}

// One row per (lecture, student) once the student has watched it through —
// the data source "completed lectures" needs to mean anything. Written by
// a student-facing "mark complete" action (Phase C); nothing wrote to this
// before it existed, so a lecture with zero rows here just means nobody's
// finished it yet, not that tracking is broken.
model LectureProgress {
  id          String   @id @default(cuid())
  lectureId   String
  studentId   String
  completedAt DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lectureId, studentId])
  @@index([studentId])
  @@map("lecture_progress")
}

model LectureIssueReport {
  id        String   @id @default(cuid())
  lectureId String
  studentId String
  note      String
  createdAt DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@map("lecture_issue_reports")
}

// Personal notes a student writes while watching a lecture — one doc per
// (student, lecture), upserted from the notes panel in LecturePlayer.tsx.
// Not shared with anyone (not the teacher, not other students) — purely a
// personal study aid, same spirit as the whiteboard's practice-board.
model LectureNote {
