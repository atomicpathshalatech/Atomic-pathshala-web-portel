generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(cuid())
  name        GlobalRole       @unique
  label       String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  emailVerified          DateTime?
  phone                  String?        @unique
  passwordHash           String
  name                   String
  photoUrl               String?
  status                 UserStatus     @default(ACTIVE)
  roleId                 String
  department             String?
  position               String?
  contractType           String?
  contractStart          DateTime?
  contractEnd            DateTime?
  contractNote           String?
  reportingManagerId     String?
  subjectScope           String[]       @default([])
  batchScope             String[]       @default([])
  securityQuestion       String?
  securityAnswerHash     String?
  passwordResetToken     String?        @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  lastLoginAt            DateTime?
  auditLogs              AuditLog[]
  userPermissionOverrides UserPermissionOverride[]
  accessRequests         AccessRequest[]
  doubtsResolved         Doubt[]        @relation("DoubtResolvedBy")
  notifications          Notification[]
  questionsCreated       Question[]     @relation("QuestionCreatedBy")
  questionsPublished     Question[]     @relation("QuestionPublishedBy")
  questionsReviewed1     Question[]     @relation("QuestionReview1By")
  questionsReviewed2     Question[]     @relation("QuestionReview2By")
  questionsEdited        Question[]     @relation("QuestionEditedBy")
  platformResourcesCreated PlatformResource[] @relation("PlatformResourceCreatedBy")
  platformResourcesDeleted PlatformResource[] @relation("PlatformResourceDeletedBy")
  resourceAuditLogs        ResourceAuditLog[]
  student                Student?
  teacher                Teacher?
  role                   Role           @relation(fields: [roleId], references: [id])
  teacherApplicationsReviewed TeacherApplication[] @relation("TeacherApplicationReviewer")
  notificationBroadcasts NotificationBroadcast[]
  homeSectionsCreated    HomePageSection[] @relation("HomeSectionCreatedBy")
  homeSectionsUpdated    HomePageSection[] @relation("HomeSectionUpdatedBy")
  homeVersionsPublished  HomePageVersion[]
  bannersCreated         Banner[]
  mediaUploaded          MediaAsset[]
  testimonialsCreated    Testimonial[]

  // --- Test Portal integration (imported from Atomic Test Portal) --------
  createdTests           Test[]            @relation("TestCreatedBy")
  createdTestTemplates   TestTemplate[]    @relation("TestTemplateCreatedBy")
  createdDpps            Dpp[]             @relation("DppCreatedBy")
  chapterReviews         ChapterReview[]   @relation("ChapterReviewActor")
  questionVersionsEdited QuestionVersion[] @relation("QuestionVersionEditedBy")
  questionAssets         QuestionAsset[]   @relation("QuestionAssetUploadedBy")
  reportsFiled           QuestionReport[]  @relation("ReportFiledBy")
  reportsClaimed         QuestionReport[]  @relation("ReportClaimedBy")
  deviceSessions         DeviceSession[]
  modulesCreated         Module[]          @relation("ModuleCreatedBy")
  brandProfilesCreated   BrandProfile[]    @relation("BrandProfileCreatedBy")
  extractionJobs         ExtractionJob[]   @relation("ExtractionJobCreatedBy")

  // --- AI Chat / Atomic Guru integration (imported from _import_atomic-ai-chat) ---
  // Reuses this existing User for login — the imported app's own User/Account/
  // Session/role/gamification fields are deliberately NOT duplicated here:
  // atomicId/role(UserRole)/isPro/isSuspended/currentStreak/longestStreak/
  // totalXp/lastActivityDate/image were dropped since Student.xp/
  // currentStreakDays/level, User.status, User.photoUrl, and the existing
  // Role/GlobalRole RBAC already cover the same ground. Everything else below
  // (chat, quiz, its own subscription/enrollment/course catalog, etc.) is
  // imported as-is as parallel models per instruction — only renamed where a
  // model name collided with an existing one (Course/Batch/Subscription).
  aiChatProfile          UserProfile?
  aiChatPreferences      UserPreference?
  aiMemory               AiMemory?
  oauthAccounts          Account[]
  oauthSessions          Session[]
  conversations          Conversation[]
  storedFiles            StoredFile[]
  aiChatSubscriptions    AiChatSubscription[]  @relation("AiChatSubscriptionUser")
  aiChatSubscriptionsGranted AiChatSubscription[] @relation("AiChatSubscriptionGrantedBy")
  aiChatAccess           UserAccess?
  aiChatEnrollments      Enrollment[]
  aiChatBatchMemberships BatchMembership[]
  aiChatTestAttempts     TestAttempt[]
  aiChatUsageEvents      UsageEvent[]
  quizAttempts           QuizAttempt[]
  answerReports          AnswerReport[]
  aiChatPasswordResetTokens PasswordResetToken[]
  revisionItems          RevisionItem[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum TeacherApplicationStatus {
  PENDING
  INTERVIEWING
  VERIFIED
  REJECTED
  ARCHIVED
}

model TeacherApplication {
  id              String                  @id @default(cuid())
  fullName        String
  email           String                  @unique
  phone           String?
  subject         String
  experienceYears Int
  bio             String?
  resumeUrl       String?
  portfolioUrl    String?
  status          TeacherApplicationStatus @default(PENDING)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  reviewedBy User? @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([subject])
  @@index([createdAt])
}

model Student {
  id               String                @id @default(cuid())
  userId           String                @unique
  enrollmentNumber String                @unique
  studentIdCode    String                @unique
  qrCodeUrl        String?
  fatherName       String
  motherName       String
  dob              DateTime
  gender           Gender
  class            String
  targetExam       String
  school           String
  city             String
  state            String
  address          String?
  bloodGroup       String?
  emergencyContact String?
  status           StudentAcademicStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // --- Gamification (XP / Level / Streak / Leaderboard) -------------------
  // `xp` is a denormalized running total — always written in the same
  // transaction as the XPEvent row that justifies it (see
  // src/lib/gamification/xp.ts:awardXp), so it never drifts from
  // sum(xpEvents.amount). Kept alongside the event log purely so "my XP" /
  // "my level" reads (header chip, profile) don't need to aggregate the
  // whole event history on every page load — the leaderboard, which DOES
  // need windowed sums ("Last 7 days" vs "All time"), queries XPEvent
  // directly instead of trusting this field.
  xp                 Int       @default(0)
  level               Int       @default(1)
  currentStreakDays   Int       @default(0)
  longestStreakDays   Int       @default(0)
  // Date-only (time truncated to midnight UTC) of the last day XP was
  // awarded — lets awardXp tell "already active today" (no streak change)
  // apart from "active yesterday" (streak++) apart from "gap of 2+ days"
  // (streak resets to 1) without a separate activity-log scan.
  lastActivityDate    DateTime?

  doubts           Doubt[]
  subscription Subscription?
  whiteboardBoards StudentWhiteboardBoard[]
  batchEnrollments BatchEnrollment[]
  handRaises       HandRaiseEvent[]
  quizResponses    QuizResponse[]
  pollResponses    PollResponse[]
  liveClassAttendances LiveClassAttendance[]
  lectureIssueReports LectureIssueReport[]
  lectureNotes        LectureNote[]
  xpEvents         XPEvent[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Test Portal integration (imported from Atomic Test Portal) --------
  // Attempt covers both a batch-scheduled class test (Attempt.testId, Test
  // bound to a BatchSchedule) and a standalone TestSeries/Dpp attempt — see
  // the Test / Dpp models below for why one Attempt model spans both.
  attempts  Attempt[]
  testAnalyses TestAttemptAnalysis[]
  bookmarks Bookmark[]
  lectureProgress LectureProgress[]
  teacherFollows  TeacherFollow[]

  @@index([city, state])
  @@index([targetExam])
  @@index([xp])
  @@map("students")
}

// Append-only XP ledger — the real source of truth for gamification.
// Student.xp/level are a denormalized cache of this table (see the comment
// there); the leaderboard's "Last 7 days" view sums this table filtered by
// createdAt rather than trusting the cache, since the cache has no
// time-window information. Every row is written by awardXp() — never insert
// directly from a route, so the Student.xp/level/streak side-effects always
// happen together with the event.
model XPEvent {
  id        String   @id @default(cuid())
  studentId String
  amount    Int
  reason    XPReason
  // Free-form context for debugging/audit — e.g. { testAttemptId } or
  // { whiteboardSessionId } — never something the leaderboard/API trusts
  // for scoring, just provenance.
  metadata  Json?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([createdAt])
  @@map("xp_events")
}

enum XPReason {
  TEST_COMPLETED
  DPP_COMPLETED
  QUIZ_CORRECT_ANSWER
  LIVE_CLASS_ATTENDANCE
  DAILY_LOGIN_STREAK
  DOUBT_RESOLVED
  LECTURE_COMPLETED
  OTHER
}

model Teacher {
  id               String            @id @default(cuid())
  userId           String            @unique
  employeeCode     String            @unique
  department       String
  subjects         String[]
  bio              String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  onboardingStatus OnboardingStatus  @default(PENDING_DOCUMENTS)
  rating           Float?
  contracts        Contract[]
  penaltyRecords   PenaltyRecord[]
  documents        TeacherDocument[]
  whiteboardBoards WhiteboardBoard[]
  batchAssignments BatchTeacher[]
  scheduleSessions BatchSchedule[]
  liveWhiteboardSessions WhiteboardSession[]
  lectures         Lecture[]
  followers        TeacherFollow[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([onboardingStatus])
  @@map("teachers")
}

// A student following a teacher. The follower LIST is never exposed by any
// API route — to the teacher, to admins, or to other students — only an
// aggregate count (see @/lib/teachers/follow.ts). This table is the only
// place the individual relationships live; keep it that way.
model TeacherFollow {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@index([teacherId])
  @@map("teacher_follows")
}

// ----------------------------------------------------------------------------
// BATCH SYSTEM — a Batch groups a cohort of students under one or more
// Teachers for a target exam/course, with its own enrollment list and class
// timetable. This is the "batch-first" structure the rest of the platform
// (Subscription, Course, Test, Live Classes) is meant to hang off of — until
// now the codebase had no first-class Batch entity at all, only marketing
// copy on the landing page.
// ----------------------------------------------------------------------------

model Batch {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  targetExam  String?
  courseId    String?
  status      BatchStatus @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course      Course?           @relation(fields: [courseId], references: [id])
  teachers    BatchTeacher[]
  enrollments BatchEnrollment[]
  schedules   BatchSchedule[]

  @@index([status])
  @@index([targetExam])
  @@map("batches")
}

model BatchTeacher {
  id        String   @id @default(cuid())
  batchId   String
  teacherId String
  subject   String?
  createdAt DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId, subject])
  @@index([teacherId])
  @@map("batch_teachers")
}

model BatchEnrollment {
  id           String                @id @default(cuid())
  batchId      String
  studentId    String
  status       BatchEnrollmentStatus @default(ACTIVE)
  enrolledById String?
  enrolledAt   DateTime              @default(now())
  droppedAt    DateTime?

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("batch_enrollments")
}

model BatchSchedule {
  id          String                @id @default(cuid())
  batchId     String
  title       String
  subject     String?
  type        ScheduleSessionType   @default(LIVE_CLASS)
  status      ScheduleSessionStatus @default(SCHEDULED)
  teacherId   String?
  startsAt    DateTime
  endsAt      DateTime
  notes       String?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Reschedule audit trail — set only by the admin-only reschedule route
  // (Phase D). previousStartsAt/previousEndsAt capture the window right
  // before THIS reschedule (not the original-ever window), which is what
  // the notice-window penalty is computed against each time.
  rescheduleCount   Int       @default(0)
  rescheduledAt     DateTime?
  rescheduledById   String?
  previousStartsAt  DateTime?
  previousEndsAt    DateTime?

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  chapterId         String?
  chapter           Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  liveWhiteboardSession WhiteboardSession?
  test                  Test?

  @@index([batchId])
  @@index([chapterId])
  @@index([startsAt])
  @@map("batch_schedules")
}

// ----------------------------------------------------------------------------
// TEST ENGINE — imported from the standalone "Atomic Test Portal" project
// (NEET/JEE mock-test platform: TestSeries → Test → Section → Question,
// bilingual, AIR/rank, security/integrity tracking) and merged with the
// batch-scheduling system already live here, rather than kept as a second,
// parallel Test model. Two deliberate bridging decisions versus a literal
// copy of the source schema:
//   1. Test.batchScheduleId (nullable, unique) is new — it's what lets a
//      Test still bind 1:1 to a BatchSchedule entry the way the old,
//      simpler Test model did (ScheduleSessionType.TEST, "class test for
//      this scheduled session"). testSeriesId is nullable for the same
//      reason: a quick class test doesn't have to belong to a named
//      TestSeries. A standalone practice/mock test (no batchScheduleId)
//      normally does have a testSeriesId, enforced at the application layer.
//   2. Attempt.studentId references Student.id, not User.id (the source
//      schema's Attempt→User). Every other student-activity table in this
//      app (XPEvent, BatchEnrollment, TestAttempt before it...) keys off
//      Student, not User directly, and gamification (awardXp on test
//      completion) needs the Student row anyway — so this is adapted for
//      consistency rather than imported literally.
// A Test with no Sections (the common case for a simple batch class test)
// gets one implicit "General" Section created alongside it — Section is
// still the only path from Test to Questions, but a teacher scheduling a
// quick class test never has to think about sections.
// ----------------------------------------------------------------------------

model TestSeries {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  description  String?
  targetBatch  String?
  className    String?
  course       String?
  examType     String?
  tags         String?
  thumbnailUrl String?
  visibility   String    @default("PRIVATE")
  status       String    @default("DRAFT")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  tests Test[]

  @@index([status])
  @@map("test_series")
}

model Test {
  id                     String       @id @default(cuid())
  testSeriesId           String?
  batchScheduleId        String?      @unique
  chapterId              String?
  templateId             String?
  name                   String
  code                   String?      @unique
  languageMode           LanguageMode @default(BOTH)
  durationMin            Int
  openTime               DateTime?
  closeTime              DateTime?
  correctMarks           Float        @default(4)
  incorrectMarks         Float        @default(-1)
  negativeMarkingEnabled Boolean      @default(true)
  questionFormat         String       @default("OBJECTIVE")
  testType               String?
  examType               String?
  description            String?
  instructions           String?
  status                 TestStatus   @default(DRAFT)
  archived               Boolean      @default(false)
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  testSeries    TestSeries?    @relation(fields: [testSeriesId], references: [id])
  batchSchedule BatchSchedule? @relation(fields: [batchScheduleId], references: [id], onDelete: Cascade)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  template      TestTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("TestCreatedBy", fields: [createdById], references: [id])
  sections      Section[]
  attempts      Attempt[]

  @@index([status])
  @@index([chapterId])
  @@index([testSeriesId])
  @@index([templateId])
  @@map("tests")
}

model Section {
  id               String            @id @default(cuid())
  testId           String
  name             String
  order            Int               @default(0)
  subject          String
  targetCount      Int               @default(0)
  marksPerQuestion Float?
  negativeMarks    Float?

  test      Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions SectionQuestion[]

  @@index([testId])
  @@map("sections")
}

model SectionQuestion {
  id                    String   @id @default(cuid())
  sectionId             String
  questionId            String
  order                 Int      @default(0)
  marksOverride         Float?
  negativeMarksOverride Float?
  reviewStatus          String   @default("PENDING")

  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([sectionId, questionId])
  @@unique([sectionId, order])
  @@index([sectionId])
  @@map("section_questions")
}

model Attempt {
  id             String        @id @default(cuid())
  testId         String?
  dppId          String?
  studentId      String
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  score          Float?
  rank           Int?
  integrityScore Int           @default(100)

  test       Test?              @relation(fields: [testId], references: [id], onDelete: Restrict)
  dpp        Dpp?               @relation(fields: [dppId], references: [id])
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]
  violations AttemptViolation[]
  analysis   TestAttemptAnalysis?

  @@unique([testId, studentId])
  @@unique([dppId, studentId])
  @@index([testId])
  @@index([studentId])
  @@map("attempts")
}

model AttemptAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds Json     @default("[]")
  isCorrect         Boolean?
  timeTakenSec      Int      @default(0)
  updatedAt         DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

model AttemptViolation {
  id        String   @id @default(cuid())
  attemptId String
  type      String
  timestamp DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("attempt_violations")
}

model TestAttemptAnalysis {
  id                      String   @id @default(cuid())
  attemptId               String   @unique
  studentId               String
  testId                  String
  totalQuestions          Int
  attempted               Int
  unattempted             Int
  correct                 Int
  incorrect               Int
  score                   Float
  maxMarks                Float
  percentage              Float
  accuracy                Float
  timeTakenSec            Int      @default(0)
  rank                    Int?
  totalTestParticipants   Int?     @default(1)
  topperScore             Float?
  gapTopperMarks          Float?
  percentile              Float?
  neetEquivalentScore     Float?
  estimatedNeetAir        Int?
  estimatedNeetAirMin     Int?
  estimatedNeetAirMax     Int?
  neetAirConfidence       String?  @default("ESTIMATED")
  estimatedCategoryRank   Int?
  estimatedCategoryRankMin Int?
  estimatedCategoryRankMax Int?
  neetDatasetYear         Int?     @default(2026)
  neetPredictionSource    String?
  subjectStats            Json     // Array of subject stats (Bio, Chem, Phys)
  questionTypeStats       Json     // Array of question-type stats
  conceptStats            Json     // Array of concept/topic stats
  chapterStats            Json     // Array of chapter stats
  errorBreakdown          Json     // Error categories (Conceptual, Silly mistake, etc.)
  ncertPlan               Json     // Personalized NCERT recommendations
  actionPlan              Json     // Next improvement steps & practice counts
  questionReviews         Json     // Detailed per-question analysis snapshots
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([testId])
  @@map("test_attempt_analyses")
}

model NEETRankDataset {
  id                 String                       @id @default(cuid())
  year               Int                          @unique
  version            String                       @default("v1.0")
  title              String
  sourceDocument     String                       @default("Official NTA NEET (UG)-2026 Re-exam Result PDF")
  totalPages         Int                          @default(15)
  isActive           Boolean                      @default(true)
  notes              String?
  references         NEETRankReference[]
  categoryReferences NEETCategoryRankReference[]
  marksBrackets      NEETMarksBracket[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@map("neet_rank_datasets")
}

model NEETRankReference {
  id               String          @id @default(cuid())
  datasetId        String
  neetRank         Int
  marks            Float
  percentile       Float?
  candidateCount   Int?
  sourcePage       Int             @default(14)
  confidence       String          @default("EXACT") // EXACT | HIGH | MEDIUM | LOW
  isExactReference Boolean         @default(true)
  createdAt        DateTime        @default(now())

  dataset NEETRankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, marks])
  @@index([datasetId, neetRank])
  @@map("neet_rank_references")
}

model NEETCategoryRankReference {
  id           String          @id @default(cuid())
  datasetId    String
  category     String          // General, OBC-NCL, Gen-EWS, SC, ST, PwBD-Female, PwBD-Male
  categoryRank Int?
  neetRank     Int
  marks        Float?
  percentile   Float?
  state        String?
  gender       String?
  sourcePage   Int             @default(9)
  confidence   String          @default("EXACT")
  createdAt    DateTime        @default(now())

  dataset NEETRankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, category, neetRank])
  @@map("neet_category_rank_references")
}

model NEETMarksBracket {
  id                   String          @id @default(cuid())
  datasetId            String
  marksFrom            Float
  marksTo              Float
  candidateCount       Int
  cumulativeCandidates Int?
  sourcePage           Int             @default(14)
  createdAt            DateTime        @default(now())

  dataset NEETRankDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, marksFrom, marksTo])
  @@map("neet_marks_brackets")
}

model QuestionVersion {
  id            String   @id @default(cuid())
  questionId    String
  versionNumber Int
  editedById    String
  editedAt      DateTime @default(now())
  reason        String?
  changeType    String   @default("EDIT")
  snapshot      Json

  editedBy User     @relation("QuestionVersionEditedBy", fields: [editedById], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, versionNumber])
  @@map("question_versions")
}

model QuestionReport {
  id            String    @id @default(cuid())
  questionId    String
  testId        String?
  reasonTags    String
  comment       String?
  screenshotUrl String?
  priority      String    @default("MEDIUM")
  status        String    @default("NEW")
  reportedById  String
  claimedById   String?
  claimedAt     DateTime?
  teacherNotes  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedBy User     @relation("ReportFiledBy", fields: [reportedById], references: [id])
  claimedBy  User?    @relation("ReportClaimedBy", fields: [claimedById], references: [id])

  @@index([questionId])
  @@index([status])
  @@map("question_reports")
}

model TestTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?                 @relation("TestTemplateCreatedBy", fields: [createdById], references: [id])
  sections  TestTemplateSection[]
  tests     Test[]

  @@map("test_templates")
}

model TestTemplateSection {
  id               String       @id @default(cuid())
  templateId       String
  name             String
  subject          String
  targetCount      Int
  marksPerQuestion Float?
  negativeMarks    Float?
  order            Int          @default(0)

  template TestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("test_template_sections")
}

model Dpp {
  id                     String       @id @default(cuid())
  code                   String       @unique
  name                   String
  subject                String
  chapter                String
  facultyName            String?
  difficulty             String       @default("MEDIUM")
  languageMode           LanguageMode @default(BOTH)
  description            String?
  tags                   String?
  instructions           String?
  estimatedTimeMin       Int          @default(30)
  correctMarks           Float        @default(4)
  incorrectMarks         Float        @default(-1)
  negativeMarkingEnabled Boolean      @default(true)
  questionTargetCount    Int          @default(0)
  status                 String       @default("DRAFT")
  level                  Int?
  topics                 String[]     @default([])
  createdById            String?
  createdAt              DateTime     @default(now())
  // Real FK to the Chapter Management System's Chapter — nullable so
  // existing/free-standing DPPs (created before this field existed, or
  // never meant to gate a specific chapter's lectures) keep working
  // unchanged. Only DPPs with this set participate in the lecture-locking
  // formula (see @/lib/chapters/progression.ts).
  chapterId              String?

  createdBy User?         @relation("DppCreatedBy", fields: [createdById], references: [id])
  chapterRef Chapter?     @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  questions DppQuestion[]
  attempts  Attempt[]

  @@index([chapterId])
  @@map("dpps")
}

model DppQuestion {
  id         String @id @default(cuid())
  dppId      String
  questionId String
  order      Int    @default(0)

  dpp      Dpp      @relation(fields: [dppId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@index([dppId])
  @@map("dpp_questions")
}

model Bookmark {
  id         String   @id @default(cuid())
  studentId  String
  questionId String
  createdAt  DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@map("bookmarks")
}

// Rank Predictor reference data — category-wise marks → expected-AIR trend,
// refreshed per admission cycle (`year`). No FK to a live Test/Attempt: this
// is published reference data, not derived from this app's own results.
model RankTrendPoint {
  id           String   @id @default(cuid())
  category     String
  marks        Int
  expectedRank Int
  year         Int      @default(2026)
  confidence   String?
  source       String?
  createdAt    DateTime @default(now())

  @@unique([category, marks, year])
  @@map("rank_trend_points")
}

// College Predictor reference data — one row per (year, round, institute,
// course, category) counselling seat allotment record.
model CollegeAllotment {
  id                String   @id @default(cuid())
  year              Int
  round             String   @default("Round 1")
  rank              Int
  quota             String
  instituteName     String
  course            String
  allottedCategory  String
  candidateCategory String
  remarks           String?
  createdAt         DateTime @default(now())

  @@index([year, rank])
  @@index([year, course, allottedCategory])
  @@map("college_allotments")
}

// Security Center — device fingerprint + multi-login control. One row per
// device a user has logged in from; `revokedAt` set when an admin or the
// user themselves signs it out remotely.
model DeviceSession {
  id            String    @id @default(cuid())
  userId        String
  deviceHash    String
  deviceType    String
  browser       String?
  os            String?
  timezone      String?
  screenRes     String?
  ipAddress     String?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sessions")
}

// Singleton — one row, id "singleton", read with findUnique. Global
// multi-login policy (e.g. "SINGLE_SESSION" forces new login to revoke
// older DeviceSessions) toggled by a Super Admin in Security Center.
model SecurityConfig {
  id     String @id @default("singleton")
  policy String @default("SINGLE_SESSION")

  @@map("security_config")
}

// ----------------------------------------------------------------------------
// LIVE TEACHING WHITEBOARD — a real-time teaching session bound to one
// scheduled class (BatchSchedule). This is distinct from WhiteboardBoard/
// StudentWhiteboardBoard above, which are personal/async practice boards —
// this one is the "teacher is live right now" session, with hand-raise and
// live quiz attached. This intentionally still binds to BatchSchedule, not
// to the `Lecture` model added below: a live class and an on-demand
// recorded lecture are different things (chat is live-only, for one — see
// LecturePlayer's disabled chat panel), so they stay separate entities
// rather than being forced into one.
// ----------------------------------------------------------------------------

model WhiteboardSession {
  id              String                  @id @default(cuid())
  batchScheduleId String                  @unique
  teacherId       String
  title           String
  status          WhiteboardSessionStatus @default(ACTIVE)
  activePageNumber Int                    @default(1)
  // Teacher-controlled from Class Settings → Chat & Poll. Teacher can always
  // send regardless of this flag; it only gates student sends (checked in
  // the messages route, not here — this column is just the on/off state).
  chatEnabled     Boolean                 @default(true)
  // Same pattern as chatEnabled, for the "Questions" (hand raise) feature.
  // Teacher can always raise/lower via the hand-raise route being teacher-
  // exempt there too; this only gates student POSTs.
  handRaiseEnabled Boolean                @default(true)
  startedAt       DateTime                @default(now())
  endedAt         DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // --- Live Classroom v2 (YouTube Live / attendance / polls) -------------
  // `status` above (ACTIVE/ENDED) stays exactly as-is — every existing
  // route (messages, hand-raise, quiz, pages) already gates on it and
  // rewriting those isn't in scope. `livePhase` is the new, finer-grained
  // state machine used specifically by the class-start/broadcast lifecycle
  // and the teacher/student UI that reflects it; ACTIVE roughly spans
  // PREPARING..ENDING, ENDED spans ENDED/RECORDED/CANCELLED/FAILED. Two
  // fields tracking related-but-different things, not two sources of truth
  // for the same thing.
  livePhase      LiveClassPhase @default(SCHEDULED)
  // Which video path this class actually uses. Defaults to the existing,
  // already-working two-way LiveKit video — every current and future class
  // stays on LiveKit unless a teacher explicitly opts into YouTube (or
  // both) when scheduling. Never flips on its own.
  videoTransport VideoTransport @default(LIVEKIT)

  // YouTube linkage — all null until videoTransport includes YOUTUBE and
  // Phase 2 (YouTubeLiveService) actually creates the broadcast/stream.
  // Deliberately no stream-key column: YouTube's API returns the stream key
  // on demand from youtubeStreamId (see YouTubeLiveService.getStreamKey),
  // so there's nothing secret to persist or encrypt here.
  youtubeBroadcastId String?
  youtubeStreamId    String?
  youtubeVideoId     String?
  youtubeLiveChatId  String?
  // Raw YouTube lifecycle status string (e.g. broadcast.status.lifeCycleStatus)
  // kept verbatim for debugging/audit — livePhase is the value everything
  // else in this app should actually branch on.
  youtubeStatus       String?
  recordingVideoId    String?
  peakViewers         Int      @default(0)

  // Presentation & Pre-flight Config
  presentationUrl     String?  // Cloud/Upload URL of PDF or PPT
  presentationName    String?  // Original file name
  presentationType    String?  // PDF / PPTX
  classroomTheme      String   @default("LIGHT") // LIGHT / DARK
  cameraShape         String   @default("SQUARE") // SQUARE / CIRCULAR
  cameraPosition      String   @default("UPPER_RIGHT")

  // Authoritative Timing & Extensions
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  actualStartedAt      DateTime?
  actualEndedAt        DateTime?
  totalExtendedMinutes Int      @default(0)
  extensionHistory     Json?    // Array of { addedMinutes: number, extendedAt: string, teacherId: string }
  cancellationReason   String?

  // Teacher connection tracking — updated by teacher heartbeat every 30s while
  // class is live. If null or stale for > 3 minutes, teacher may be disconnected.
  lastHeartbeatAt      DateTime?

  // Recording lifecycle — egressId is set the moment LiveKit egress starts;
  // recordingStatus mirrors LiveKit egress status for display purposes.
  // recordingStatus: NONE | STARTING | RECORDING | STOPPING | PROCESSING | READY | FAILED
  recordingEgressId    String?
  recordingStatus      String   @default("NONE")

  batchSchedule BatchSchedule        @relation(fields: [batchScheduleId], references: [id], onDelete: Cascade)
  teacher       Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  pages         WhiteboardPage[]
  quizzes       QuizSession[]
  polls         PollSession[]
  handRaises    HandRaiseEvent[]
  messages      WhiteboardMessage[]
  attendances   LiveClassAttendance[]
  doubts        Doubt[]

  @@index([teacherId])
  @@index([status])
  @@index([livePhase])
  @@map("whiteboard_sessions")
}

// The class-start/broadcast lifecycle state machine (spec: LIVE must never
// be inferred purely from a teacher button click — it has to be confirmed
// by actual stream state once videoTransport includes YOUTUBE; for a pure
// LIVEKIT class there's no external stream to poll, so that class moves
// PREPARING → LIVE immediately, same as today).
enum LiveClassPhase {
  SCHEDULED
  PREPARING
  WAITING_FOR_STREAM
  LIVE
  ENDING
  ENDED
  PROCESSING_RECORDING
  RECORDED
  CANCELLED
  FAILED
}

enum VideoTransport {
  LIVEKIT
  YOUTUBE
  BOTH
}

model WhiteboardPage {
  id         String   @id @default(cuid())
  sessionId  String
  pageNumber Int
  background String   @default("blank")
  objects    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session WhiteboardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageNumber])
  @@index([sessionId])
  @@map("whiteboard_pages")
}

model QuizSession {
  id                   String            @id @default(cuid())
  whiteboardSessionId  String
  questionText         String?           @db.Text
  isQuickQuiz          Boolean           @default(false)
  options              Json
  correctOption        String?
  timeLimitSec         Int               @default(30)
  status               QuizSessionStatus @default(ACTIVE)
  createdById          String
  startedAt            DateTime          @default(now())
  revealedAt           DateTime?

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  responses         QuizResponse[]

  @@index([whiteboardSessionId])
  @@index([status])
  @@map("quiz_sessions")
}

model QuizResponse {
  id             String   @id @default(cuid())
  quizSessionId  String
  studentId      String
  selectedOption String
  responseTimeMs Int
  isCorrect      Boolean?
  submittedAt    DateTime @default(now())

  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizSessionId, studentId])
  @@index([quizSessionId])
  @@map("quiz_responses")
}

model HandRaiseEvent {
  id                  String          @id @default(cuid())
  whiteboardSessionId String
  studentId           String
  status              HandRaiseStatus @default(PENDING)
  // What type of participation is being requested
  requestType         String          @default("CHAT") // CHAT | AUDIO | VIDEO
  raisedAt            DateTime        @default(now())
  resolvedAt          DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  // Whether LiveKit publish permission was granted for this hand raise
  liveKitGranted      Boolean         @default(false)

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([whiteboardSessionId, status])
  @@map("hand_raise_events")
}

// Live class chat — the real implementation of what LecturePlayer's chat
// panel has been telling students ("Chats will only be visible in a live
// class") since before this model existed. authorRole/authorUserId/
// authorName are denormalized (not a User relation) on purpose: this mirrors
// how AuditLog stores actor identity, keeps the messages route from needing
// an extra join on every send, and survives the author's Teacher/Student
// profile changing later without rewriting chat history.
model WhiteboardMessage {
  id                   String   @id @default(cuid())
  whiteboardSessionId  String
  authorRole           String
  authorUserId         String
  authorName           String
  body                 String   @db.Text
  createdAt            DateTime @default(now())

  // --- Moderation / structure (Live Classroom v2) -------------------------
  // Soft delete: moderation history (who deleted what) stays intact instead
  // of vanishing, and "deleted by teacher" vs "deleted by author" can still
  // be told apart later if that's ever needed. Routes must filter
  // deletedAt: null on every read.
  deletedAt       DateTime?
  pinnedAt        DateTime?
  isSystemMessage Boolean   @default(false)
  isAnnouncement  Boolean   @default(false)
  // Student-settable "mark as question" checkbox at send time — not an AI
  // classification (the spec explicitly rules that out for v1). Powers the
  // teacher's QUESTIONS chat filter deterministically.
  flaggedAsQuestion Boolean @default(false)
  parentMessageId   String?

  whiteboardSession WhiteboardSession   @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  parentMessage     WhiteboardMessage?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies           WhiteboardMessage[] @relation("MessageReplies")
  reactions         ChatReaction[]
  doubts            Doubt[]

  @@index([whiteboardSessionId, createdAt])
  @@index([whiteboardSessionId, pinnedAt])
  @@map("whiteboard_messages")
}

// One row per (message, user, emoji) — a user can react with several
// different emoji on the same message, but not stack the same one twice
// (that's a UI toggle, not a counter to spam).
model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message WhiteboardMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

// Attendance is derived from a heartbeat the client sends while the live
// class tab is open and focused, not merely "the tab was open" — joinedAt/
// leftAt/lastSeenAt/activeDurationSec are all written server-side from
// those heartbeats. One row per student per class: a reconnect updates the
// SAME row (reconnectCount++) rather than creating a new one, which is what
// makes rejoining idempotent (spec: never duplicate an active session).
model LiveClassAttendance {
  id                  String    @id @default(cuid())
  whiteboardSessionId String
  studentId           String
  joinedAt            DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  leftAt              DateTime?
  reconnectCount      Int       @default(0)
  activeDurationSec   Int       @default(0)
  // Incremented server-side on real interactions this student made in this
  // class (chat send, quiz/poll response, hand raise) — never client-
  // reported, so it can't be inflated by an idle open tab.
  interactionCount    Int       @default(0)
  quizParticipated    Boolean   @default(false)

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([whiteboardSessionId, studentId])
  @@index([whiteboardSessionId])
  @@map("live_class_attendances")
}

// Poll — deliberately separate from QuizSession/QuizResponse (spec item 20):
// no correctOption/isCorrect scoring, and an `anonymous` flag. Even an
// anonymous poll still records studentId server-side (that's what makes the
// anti-duplicate-vote constraint below possible, and what attendance
// interaction-counting needs) — "anonymous" means the teacher-facing API
// never returns studentId back out, not that it was never stored.
model PollSession {
  id                  String            @id @default(cuid())
  whiteboardSessionId String
  questionText        String            @db.Text
  options             Json
  anonymous           Boolean           @default(true)
  status              PollSessionStatus @default(ACTIVE)
  createdById         String
  startedAt           DateTime          @default(now())
  closedAt            DateTime?

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  responses         PollResponse[]

  @@index([whiteboardSessionId])
  @@index([status])
  @@map("poll_sessions")
}

model PollResponse {
  id             String   @id @default(cuid())
  pollSessionId  String
  studentId      String
  selectedOption String
  submittedAt    DateTime @default(now())

  pollSession PollSession @relation(fields: [pollSessionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollSessionId, studentId])
  @@index([pollSessionId])
  @@map("poll_responses")
}

enum PollSessionStatus {
  ACTIVE
  CLOSED
}

// ----------------------------------------------------------------------------
// WHITEBOARD — teacher-side (session/practice board) and student-side
// (personal practice board) are separate models, matching how Student/
// Teacher are already modeled separately everywhere else in this schema.
// `strokes` is untyped Json: either a plain array of stroke objects, or
// (when a PDF deck is loaded) an object tagged `__type: "pdf-deck"` holding
// per-slide annotations. `thumbnailDataUrl` is a flattened PNG snapshot used
// for the saved-boards list preview.
// ----------------------------------------------------------------------------

model WhiteboardBoard {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  title            String
  strokes          Json
  thumbnailDataUrl String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@map("whiteboard_boards")
}

model StudentWhiteboardBoard {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title            String
  strokes          Json
  thumbnailDataUrl String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("student_whiteboard_boards")
}

model TeacherDocument {
  id            String                     @id @default(cuid())
  teacherId     String
  type          DocumentType
  fileUrl       String
  fileName      String?
  status        DocumentVerificationStatus @default(PENDING)
  rejectionNote String?
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  teacher       Teacher                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@map("teacher_documents")
}

model Contract {
  id             String         @id @default(cuid())
  teacherId      String
  title          String
  bodyText       String
  status         ContractStatus @default(DRAFT)
  sentAt         DateTime?
  signedAt       DateTime?
  signedName     String?
  signatureIp    String?
  declinedReason String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@map("contracts")
}

model PenaltyRule {
  id             String               @id @default(cuid())
  name           String
  description    String?
  deductionType  PenaltyDeductionType @default(FIXED_AMOUNT)
  deductionValue Float
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  records        PenaltyRecord[]

  @@map("penalty_rules")
}

model PenaltyRecord {
  id          String      @id @default(cuid())
  teacherId   String
  ruleId      String
  amount      Float
  month       String
  note        String?
  createdById String
  createdAt   DateTime    @default(now())
  rule        PenaltyRule @relation(fields: [ruleId], references: [id])
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([month])
  @@map("penalty_records")
}

model Course {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subjects    Subject[]
  batches     Batch[]

  @@map("courses")
}

model Subject {
  id        String    @id @default(cuid())
  title     String
  courseId  String
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("subjects")
}

model Chapter {
  id        String    @id @default(cuid())
  // Business-facing unique identifier for the Chapter Management System
  // spec — a 6-digit string starting with "6", generated by
  // generateChapterId() in @/lib/chapters/code.ts, independent of every
  // other entity's id/code sequence. NOT the same thing as the ephemeral
  // "CH-BIO-001"-style display code computed on the fly by
  // @/lib/batch/master-chapters.ts for the unrelated pre-existing
  // "import a master syllabus into a batch's live-class schedule" demo
  // feature (ChapterImportModal) — that code is never persisted anywhere
  // and isn't part of this model.
  chapterId String?   @unique
  title     String
  // Student-facing chapter scope, persisted (not UI-only text) per the
  // Chapter → Lecture → DPP → Chapter Test academic pipeline spec. All
  // optional so every pre-existing chapter keeps working unchanged.
  description        String?
  learningObjectives String?
  prerequisites      String?
  subjectId String
  medium    Medium    @default(ENGLISH)
  status    ChapterStatus @default(DRAFT)
  order     Int       @default(0)
  createdById String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lectures       Lecture[]
  dpps           Dpp[]
  tests          Test[]
  batchSchedules BatchSchedule[]
  reviews        ChapterReview[]
  notices        ChapterNotice[]

  @@index([subjectId])
  @@index([subjectId, title])
  @@index([status])
  @@map("chapters")
}

enum Medium {
  HINDI
  ENGLISH
  HINGLISH
}

// Append-only audit trail for the Chapter review workflow (SUBMITTED by the
// author, then APPROVED/REJECTED/CHANGES_REQUESTED by an admin/reviewer via
// POST /api/team/chapters/:id/review). Never updated in place — a new row
// is created for every decision, so review history is reproducible even
// after a chapter is resubmitted and re-reviewed multiple times.
enum ChapterReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model ChapterReview {
  id             String              @id @default(cuid())
  chapterId      String
  action         ChapterReviewAction
  // Required at the application level for REJECTED/CHANGES_REQUESTED
  // (POST /review enforces this before writing the row); optional here
  // because the author's own SUBMITTED entry has no reviewer comment.
  comment        String?
  actorId        String
  previousStatus ChapterStatus
  newStatus      ChapterStatus
  createdAt      DateTime            @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  actor   User    @relation("ChapterReviewActor", fields: [actorId], references: [id])

  @@index([chapterId])
  @@index([actorId])
  @@map("chapter_reviews")
}

model ChapterNotice {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  content     String
  category    String   @default("ANNOUNCEMENT") // ANNOUNCEMENT, IMPORTANT, EXAM, HOMEWORK, GENERAL
  isPinned    Boolean  @default(false)
  authorName  String   @default("Faculty")
  authorRole  String   @default("TEACHER")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@index([chapterId, isPinned, createdAt])
  @@map("chapter_notices")
}

// State machine for the Chapter Management System — a chapter moves
// forward through content production before it's visible to students.
// Transitions are backend-enforced (see chapter status-transition route in
// Phase B), not just disabled buttons in the UI.
enum ChapterStatus {
  DRAFT
  LECTURES_IN_PROGRESS
  LECTURES_COMPLETE
  TESTS_PENDING
  READY_TO_PUBLISH
  // --- Admin review workflow (Chapter → Lecture → DPP → Chapter Test →
  // Review pipeline spec) — entered only via POST /submit and
  // POST /review, never the generic /status route, so a teacher can
  // never self-approve their own chapter. ---
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  PUBLISHED
  ARCHIVED
}

// Question Bank — replaced with the Atomic Test Portal's richer, bilingual
// question model (imported): subject/chapter/topic are free text here, not
// Subject/Chapter model FKs (Subject/Chapter above stay, used only by the
// Lecture Library now) — this matches the source schema and is what makes
// PYQ categorization (pyqSource/questionCode) and per-language translations
// possible without forcing every question into the Course/Subject/Chapter
// tree. `isPublished`/`publishedById`/`publishedAt` replaces the old
// `status: PENDING|VERIFIED|FLAGGED` verification workflow — same idea
// (draft vs. live), source schema's naming kept as-is.
model Question {
  id            String       @id @default(cuid())
  subject       String
  chapter       String?
  topic         String?
  subTopic      String?
  type          QuestionType @default(SINGLE_CORRECT)
  difficulty    Difficulty   @default(MEDIUM)
  imageUrl      String?
  category      String?
  pyqSource     String?
  questionCode  String?      @unique
  solution      String?
  tags          String?
  ncertBook     String?
  ncertClass    String?
  ncertChapter  String?
  ncertPage     String?
  ncertSection  String?
  ncertLine     String?
  status        String       @default("DRAFT") // DRAFT | REVIEW_1 | REVIEW_2 | PUBLISHED | REJECTED
  version       Int          @default(1)
  review1Status String? // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  review1ById   String?
  review1At     DateTime?
  review1Notes  String?
  review2Status String? // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  review2ById   String?
  review2At     DateTime?
  review2Notes  String?
  editedById    String?
  editedAt      DateTime?
  usageCount    Int          @default(0)
  isPublished   Boolean      @default(false)
  publishedAt   DateTime?
  publishedById String?
  createdById   String?
  createdAt     DateTime     @default(now())

  createdBy    User?                 @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  publishedBy  User?                 @relation("QuestionPublishedBy", fields: [publishedById], references: [id])
  review1By    User?                 @relation("QuestionReview1By", fields: [review1ById], references: [id])
  review2By    User?                 @relation("QuestionReview2By", fields: [review2ById], references: [id])
  editedBy     User?                 @relation("QuestionEditedBy", fields: [editedById], references: [id])
  translations QuestionTranslation[]
  versions     QuestionVersion[]
  reports      QuestionReport[]
  sectionLinks SectionQuestion[]
  dppLinks     DppQuestion[]
  bookmarks    Bookmark[]
  answers      AttemptAnswer[]
  assets       QuestionAsset[]
  revisionAttempts RevisionQuestionAttempt[]

  @@index([subject])
  @@index([difficulty])
  @@index([isPublished])
  @@map("questions")
}

// One row per language a question is authored in (Hindi/English/etc.) —
// statement, options and the correct-option set are all per-language so a
// bilingual question never has to force one canonical wording.
model QuestionTranslation {
  id               String   @id @default(cuid())
  questionId       String
  language         String
  statement        String
  options          Json
  correctOptionIds Json
  solution         String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
  @@map("question_translations")
}

