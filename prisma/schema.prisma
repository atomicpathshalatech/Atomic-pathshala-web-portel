generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(cuid())
  name        GlobalRole       @unique
  label       String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  emailVerified          DateTime?
  phone                  String?        @unique
  passwordHash           String
  name                   String
  photoUrl               String?
  status                 UserStatus     @default(ACTIVE)
  roleId                 String
  securityQuestion       String?
  securityAnswerHash     String?
  passwordResetToken     String?        @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  lastLoginAt            DateTime?
  auditLogs              AuditLog[]
  doubtsResolved         Doubt[]        @relation("DoubtResolvedBy")
  notifications          Notification[]
  questionsCreated       Question[]     @relation("QuestionCreatedBy")
  questionsVerified      Question[]     @relation("QuestionVerifiedBy")
  student                Student?
  teacher                Teacher?
  role                   Role           @relation(fields: [roleId], references: [id])
  teacherApplicationsReviewed TeacherApplication[] @relation("TeacherApplicationReviewer")
  notificationBroadcasts NotificationBroadcast[]
  homeSectionsCreated    HomePageSection[] @relation("HomeSectionCreatedBy")
  homeSectionsUpdated    HomePageSection[] @relation("HomeSectionUpdatedBy")
  homeVersionsPublished  HomePageVersion[]
  bannersCreated         Banner[]
  mediaUploaded          MediaAsset[]
  testimonialsCreated    Testimonial[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum TeacherApplicationStatus {
  PENDING
  INTERVIEWING
  VERIFIED
  REJECTED
  ARCHIVED
}

model TeacherApplication {
  id              String                  @id @default(cuid())
  fullName        String
  email           String                  @unique
  phone           String?
  subject         String
  experienceYears Int
  bio             String?
  resumeUrl       String?
  portfolioUrl    String?
  status          TeacherApplicationStatus @default(PENDING)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  reviewedBy User? @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([subject])
  @@index([createdAt])
}

model Student {
  id               String                @id @default(cuid())
  userId           String                @unique
  enrollmentNumber String                @unique
  studentIdCode    String                @unique
  qrCodeUrl        String?
  fatherName       String
  motherName       String
  dob              DateTime
  gender           Gender
  class            String
  targetExam       String
  school           String
  city             String
  state            String
  address          String?
  bloodGroup       String?
  emergencyContact String?
  status           StudentAcademicStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // --- Gamification (XP / Level / Streak / Leaderboard) -------------------
  // `xp` is a denormalized running total — always written in the same
  // transaction as the XPEvent row that justifies it (see
  // src/lib/gamification/xp.ts:awardXp), so it never drifts from
  // sum(xpEvents.amount). Kept alongside the event log purely so "my XP" /
  // "my level" reads (header chip, profile) don't need to aggregate the
  // whole event history on every page load — the leaderboard, which DOES
  // need windowed sums ("Last 7 days" vs "All time"), queries XPEvent
  // directly instead of trusting this field.
  xp                 Int       @default(0)
  level               Int       @default(1)
  currentStreakDays   Int       @default(0)
  longestStreakDays   Int       @default(0)
  // Date-only (time truncated to midnight UTC) of the last day XP was
  // awarded — lets awardXp tell "already active today" (no streak change)
  // apart from "active yesterday" (streak++) apart from "gap of 2+ days"
  // (streak resets to 1) without a separate activity-log scan.
  lastActivityDate    DateTime?

  doubts           Doubt[]
  subscription Subscription?
  whiteboardBoards StudentWhiteboardBoard[]
  batchEnrollments BatchEnrollment[]
  handRaises       HandRaiseEvent[]
  quizResponses    QuizResponse[]
  pollResponses    PollResponse[]
  liveClassAttendances LiveClassAttendance[]
  testAttempts     TestAttempt[]
  lectureIssueReports LectureIssueReport[]
  lectureNotes        LectureNote[]
  xpEvents         XPEvent[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, state])
  @@index([targetExam])
  @@index([xp])
  @@map("students")
}

// Append-only XP ledger — the real source of truth for gamification.
// Student.xp/level are a denormalized cache of this table (see the comment
// there); the leaderboard's "Last 7 days" view sums this table filtered by
// createdAt rather than trusting the cache, since the cache has no
// time-window information. Every row is written by awardXp() — never insert
// directly from a route, so the Student.xp/level/streak side-effects always
// happen together with the event.
model XPEvent {
  id        String   @id @default(cuid())
  studentId String
  amount    Int
  reason    XPReason
  // Free-form context for debugging/audit — e.g. { testAttemptId } or
  // { whiteboardSessionId } — never something the leaderboard/API trusts
  // for scoring, just provenance.
  metadata  Json?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([createdAt])
  @@map("xp_events")
}

enum XPReason {
  TEST_COMPLETED
  DPP_COMPLETED
  QUIZ_CORRECT_ANSWER
  LIVE_CLASS_ATTENDANCE
  DAILY_LOGIN_STREAK
  DOUBT_RESOLVED
  OTHER
}

model Teacher {
  id               String            @id @default(cuid())
  userId           String            @unique
  employeeCode     String            @unique
  department       String
  subjects         String[]
  bio              String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  onboardingStatus OnboardingStatus  @default(PENDING_DOCUMENTS)
  rating           Float?
  contracts        Contract[]
  penaltyRecords   PenaltyRecord[]
  documents        TeacherDocument[]
  whiteboardBoards WhiteboardBoard[]
  batchAssignments BatchTeacher[]
  scheduleSessions BatchSchedule[]
  liveWhiteboardSessions WhiteboardSession[]
  lectures         Lecture[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([onboardingStatus])
  @@map("teachers")
}

// ----------------------------------------------------------------------------
// BATCH SYSTEM — a Batch groups a cohort of students under one or more
// Teachers for a target exam/course, with its own enrollment list and class
// timetable. This is the "batch-first" structure the rest of the platform
// (Subscription, Course, Test, Live Classes) is meant to hang off of — until
// now the codebase had no first-class Batch entity at all, only marketing
// copy on the landing page.
// ----------------------------------------------------------------------------

model Batch {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  targetExam  String?
  courseId    String?
  status      BatchStatus @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course      Course?           @relation(fields: [courseId], references: [id])
  teachers    BatchTeacher[]
  enrollments BatchEnrollment[]
  schedules   BatchSchedule[]

  @@index([status])
  @@index([targetExam])
  @@map("batches")
}

model BatchTeacher {
  id        String   @id @default(cuid())
  batchId   String
  teacherId String
  subject   String?
  createdAt DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId, subject])
  @@index([teacherId])
  @@map("batch_teachers")
}

model BatchEnrollment {
  id           String                @id @default(cuid())
  batchId      String
  studentId    String
  status       BatchEnrollmentStatus @default(ACTIVE)
  enrolledById String?
  enrolledAt   DateTime              @default(now())
  droppedAt    DateTime?

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("batch_enrollments")
}

model BatchSchedule {
  id          String                @id @default(cuid())
  batchId     String
  title       String
  subject     String?
  type        ScheduleSessionType   @default(LIVE_CLASS)
  status      ScheduleSessionStatus @default(SCHEDULED)
  teacherId   String?
  startsAt    DateTime
  endsAt      DateTime
  notes       String?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  liveWhiteboardSession WhiteboardSession?
  test                  Test?

  @@index([batchId])
  @@index([startsAt])
  @@map("batch_schedules")
}

// ----------------------------------------------------------------------------
// TEST ENGINE — a Test is delivered through a BatchSchedule entry the same
// way a live whiteboard session is: `ScheduleSessionType.TEST` was already a
// value in the enum above before this update (a hook the original schema
// clearly anticipated but never wired up), so a Test binds 1:1 to that
// schedule entry — reusing its startsAt/endsAt as the test's open/close
// window instead of inventing a parallel scheduling concept. This mirrors
// WhiteboardSession's relationship to BatchSchedule exactly.
// ----------------------------------------------------------------------------

model Test {
  id              String     @id @default(cuid())
  batchScheduleId String     @unique
  title           String
  instructions    String?
  durationMin     Int
  status          TestStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  batchSchedule BatchSchedule  @relation(fields: [batchScheduleId], references: [id], onDelete: Cascade)
  questions     TestQuestion[]
  attempts      TestAttempt[]

  @@index([status])
  @@map("tests")
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
  @@unique([testId, order])
  @@index([testId])
  @@map("test_questions")
}

model TestAttempt {
  id               String            @id @default(cuid())
  testId           String
  studentId        String
  status           TestAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  score            Float?
  correctCount     Int?
  incorrectCount   Int?
  unattemptedCount Int?

  test    Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers TestAttemptAnswer[]

  @@unique([testId, studentId])
  @@index([testId])
  @@index([studentId])
  @@map("test_attempts")
}

model TestAttemptAnswer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption String?
  isCorrect      Boolean?
  marksAwarded   Float?
  answeredAt     DateTime @default(now())

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("test_attempt_answers")
}

// ----------------------------------------------------------------------------
// LIVE TEACHING WHITEBOARD — a real-time teaching session bound to one
// scheduled class (BatchSchedule). This is distinct from WhiteboardBoard/
// StudentWhiteboardBoard above, which are personal/async practice boards —
// this one is the "teacher is live right now" session, with hand-raise and
// live quiz attached. This intentionally still binds to BatchSchedule, not
// to the `Lecture` model added below: a live class and an on-demand
// recorded lecture are different things (chat is live-only, for one — see
// LecturePlayer's disabled chat panel), so they stay separate entities
// rather than being forced into one.
// ----------------------------------------------------------------------------

model WhiteboardSession {
  id              String                  @id @default(cuid())
  batchScheduleId String                  @unique
  teacherId       String
  title           String
  status          WhiteboardSessionStatus @default(ACTIVE)
  activePageNumber Int                    @default(1)
  // Teacher-controlled from Class Settings → Chat & Poll. Teacher can always
  // send regardless of this flag; it only gates student sends (checked in
  // the messages route, not here — this column is just the on/off state).
  chatEnabled     Boolean                 @default(true)
  // Same pattern as chatEnabled, for the "Questions" (hand raise) feature.
  // Teacher can always raise/lower via the hand-raise route being teacher-
  // exempt there too; this only gates student POSTs.
  handRaiseEnabled Boolean                @default(true)
  startedAt       DateTime                @default(now())
  endedAt         DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // --- Live Classroom v2 (YouTube Live / attendance / polls) -------------
  // `status` above (ACTIVE/ENDED) stays exactly as-is — every existing
  // route (messages, hand-raise, quiz, pages) already gates on it and
  // rewriting those isn't in scope. `livePhase` is the new, finer-grained
  // state machine used specifically by the class-start/broadcast lifecycle
  // and the teacher/student UI that reflects it; ACTIVE roughly spans
  // PREPARING..ENDING, ENDED spans ENDED/RECORDED/CANCELLED/FAILED. Two
  // fields tracking related-but-different things, not two sources of truth
  // for the same thing.
  livePhase      LiveClassPhase @default(SCHEDULED)
  // Which video path this class actually uses. Defaults to the existing,
  // already-working two-way LiveKit video — every current and future class
  // stays on LiveKit unless a teacher explicitly opts into YouTube (or
  // both) when scheduling. Never flips on its own.
  videoTransport VideoTransport @default(LIVEKIT)

  // YouTube linkage — all null until videoTransport includes YOUTUBE and
  // Phase 2 (YouTubeLiveService) actually creates the broadcast/stream.
  // Deliberately no stream-key column: YouTube's API returns the stream key
  // on demand from youtubeStreamId (see YouTubeLiveService.getStreamKey),
  // so there's nothing secret to persist or encrypt here.
  youtubeBroadcastId String?
  youtubeStreamId    String?
  youtubeVideoId     String?
  youtubeLiveChatId  String?
  // Raw YouTube lifecycle status string (e.g. broadcast.status.lifeCycleStatus)
  // kept verbatim for debugging/audit — livePhase is the value everything
  // else in this app should actually branch on.
  youtubeStatus       String?
  recordingVideoId    String?
  peakViewers         Int      @default(0)

  batchSchedule BatchSchedule        @relation(fields: [batchScheduleId], references: [id], onDelete: Cascade)
  teacher       Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  pages         WhiteboardPage[]
  quizzes       QuizSession[]
  polls         PollSession[]
  handRaises    HandRaiseEvent[]
  messages      WhiteboardMessage[]
  attendances   LiveClassAttendance[]
  doubts        Doubt[]

  @@index([teacherId])
  @@index([status])
  @@index([livePhase])
  @@map("whiteboard_sessions")
}

// The class-start/broadcast lifecycle state machine (spec: LIVE must never
// be inferred purely from a teacher button click — it has to be confirmed
// by actual stream state once videoTransport includes YOUTUBE; for a pure
// LIVEKIT class there's no external stream to poll, so that class moves
// PREPARING → LIVE immediately, same as today).
enum LiveClassPhase {
  SCHEDULED
  PREPARING
  WAITING_FOR_STREAM
  LIVE
  ENDING
  ENDED
  PROCESSING_RECORDING
  RECORDED
  CANCELLED
  FAILED
}

enum VideoTransport {
  LIVEKIT
  YOUTUBE
  BOTH
}

model WhiteboardPage {
  id         String   @id @default(cuid())
  sessionId  String
  pageNumber Int
  background String   @default("blank")
  objects    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session WhiteboardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageNumber])
  @@index([sessionId])
  @@map("whiteboard_pages")
}

model QuizSession {
  id                   String            @id @default(cuid())
  whiteboardSessionId  String
  questionText         String?           @db.Text
  isQuickQuiz          Boolean           @default(false)
  options              Json
  correctOption        String?
  timeLimitSec         Int               @default(30)
  status               QuizSessionStatus @default(ACTIVE)
  createdById          String
  startedAt            DateTime          @default(now())
  revealedAt           DateTime?

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  responses         QuizResponse[]

  @@index([whiteboardSessionId])
  @@index([status])
  @@map("quiz_sessions")
}

model QuizResponse {
  id             String   @id @default(cuid())
  quizSessionId  String
  studentId      String
  selectedOption String
  responseTimeMs Int
  isCorrect      Boolean?
  submittedAt    DateTime @default(now())

  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizSessionId, studentId])
  @@index([quizSessionId])
  @@map("quiz_responses")
}

model HandRaiseEvent {
  id                  String          @id @default(cuid())
  whiteboardSessionId String
  studentId           String
  status              HandRaiseStatus @default(PENDING)
  raisedAt            DateTime        @default(now())
  resolvedAt          DateTime?

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([whiteboardSessionId, status])
  @@map("hand_raise_events")
}

// Live class chat — the real implementation of what LecturePlayer's chat
// panel has been telling students ("Chats will only be visible in a live
// class") since before this model existed. authorRole/authorUserId/
// authorName are denormalized (not a User relation) on purpose: this mirrors
// how AuditLog stores actor identity, keeps the messages route from needing
// an extra join on every send, and survives the author's Teacher/Student
// profile changing later without rewriting chat history.
model WhiteboardMessage {
  id                   String   @id @default(cuid())
  whiteboardSessionId  String
  authorRole           String
  authorUserId         String
  authorName           String
  body                 String   @db.Text
  createdAt            DateTime @default(now())

  // --- Moderation / structure (Live Classroom v2) -------------------------
  // Soft delete: moderation history (who deleted what) stays intact instead
  // of vanishing, and "deleted by teacher" vs "deleted by author" can still
  // be told apart later if that's ever needed. Routes must filter
  // deletedAt: null on every read.
  deletedAt       DateTime?
  pinnedAt        DateTime?
  isSystemMessage Boolean   @default(false)
  isAnnouncement  Boolean   @default(false)
  // Student-settable "mark as question" checkbox at send time — not an AI
  // classification (the spec explicitly rules that out for v1). Powers the
  // teacher's QUESTIONS chat filter deterministically.
  flaggedAsQuestion Boolean @default(false)
  parentMessageId   String?

  whiteboardSession WhiteboardSession   @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  parentMessage     WhiteboardMessage?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies           WhiteboardMessage[] @relation("MessageReplies")
  reactions         ChatReaction[]
  doubts            Doubt[]

  @@index([whiteboardSessionId, createdAt])
  @@index([whiteboardSessionId, pinnedAt])
  @@map("whiteboard_messages")
}

// One row per (message, user, emoji) — a user can react with several
// different emoji on the same message, but not stack the same one twice
// (that's a UI toggle, not a counter to spam).
model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message WhiteboardMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

// Attendance is derived from a heartbeat the client sends while the live
// class tab is open and focused, not merely "the tab was open" — joinedAt/
// leftAt/lastSeenAt/activeDurationSec are all written server-side from
// those heartbeats. One row per student per class: a reconnect updates the
// SAME row (reconnectCount++) rather than creating a new one, which is what
// makes rejoining idempotent (spec: never duplicate an active session).
model LiveClassAttendance {
  id                  String    @id @default(cuid())
  whiteboardSessionId String
  studentId           String
  joinedAt            DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  leftAt              DateTime?
  reconnectCount      Int       @default(0)
  activeDurationSec   Int       @default(0)
  // Incremented server-side on real interactions this student made in this
  // class (chat send, quiz/poll response, hand raise) — never client-
  // reported, so it can't be inflated by an idle open tab.
  interactionCount    Int       @default(0)
  quizParticipated    Boolean   @default(false)

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([whiteboardSessionId, studentId])
  @@index([whiteboardSessionId])
  @@map("live_class_attendances")
}

// Poll — deliberately separate from QuizSession/QuizResponse (spec item 20):
// no correctOption/isCorrect scoring, and an `anonymous` flag. Even an
// anonymous poll still records studentId server-side (that's what makes the
// anti-duplicate-vote constraint below possible, and what attendance
// interaction-counting needs) — "anonymous" means the teacher-facing API
// never returns studentId back out, not that it was never stored.
model PollSession {
  id                  String            @id @default(cuid())
  whiteboardSessionId String
  questionText        String            @db.Text
  options             Json
  anonymous           Boolean           @default(true)
  status              PollSessionStatus @default(ACTIVE)
  createdById         String
  startedAt           DateTime          @default(now())
  closedAt            DateTime?

  whiteboardSession WhiteboardSession @relation(fields: [whiteboardSessionId], references: [id], onDelete: Cascade)
  responses         PollResponse[]

  @@index([whiteboardSessionId])
  @@index([status])
  @@map("poll_sessions")
}

model PollResponse {
  id             String   @id @default(cuid())
  pollSessionId  String
  studentId      String
  selectedOption String
  submittedAt    DateTime @default(now())

  pollSession PollSession @relation(fields: [pollSessionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollSessionId, studentId])
  @@index([pollSessionId])
  @@map("poll_responses")
}

enum PollSessionStatus {
  ACTIVE
  CLOSED
}

// ----------------------------------------------------------------------------
// WHITEBOARD — teacher-side (session/practice board) and student-side
// (personal practice board) are separate models, matching how Student/
// Teacher are already modeled separately everywhere else in this schema.
// `strokes` is untyped Json: either a plain array of stroke objects, or
// (when a PDF deck is loaded) an object tagged `__type: "pdf-deck"` holding
// per-slide annotations. `thumbnailDataUrl` is a flattened PNG snapshot used
// for the saved-boards list preview.
// ----------------------------------------------------------------------------

model WhiteboardBoard {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  title            String
  strokes          Json
  thumbnailDataUrl String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@map("whiteboard_boards")
}

model StudentWhiteboardBoard {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title            String
  strokes          Json
  thumbnailDataUrl String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("student_whiteboard_boards")
}

model TeacherDocument {
  id            String                     @id @default(cuid())
  teacherId     String
  type          DocumentType
  fileUrl       String
  fileName      String?
  status        DocumentVerificationStatus @default(PENDING)
  rejectionNote String?
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  teacher       Teacher                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

