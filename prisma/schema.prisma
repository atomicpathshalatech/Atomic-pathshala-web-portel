// ==========================================================================
// HOME PAGE CMS / PAGE BUILDER
// ==========================================================================
// Design: HomePageSection rows are the live DRAFT — admins edit these
// directly (create/edit/delete/reorder), and nothing here is ever public.
// Publishing snapshots the current draft into a new HomePageVersion (a JSON
// copy, not a reference) — the public site only ever reads the latest
// HomePageVersion, never the draft table. This is what makes "save draft
// without affecting the live site" and "restore an old version" both just
// work: restoring copies an old snapshot back into both the draft table
// (so editing continues from there) and creates a fresh version row (so
// the public site picks it up) — nothing is ever destroyed.

enum HomeSectionType {
  HERO
  IMAGE_BANNER
  TEXT_IMAGE
  FEATURES
  COURSE_GRID
  BATCH_GRID
  TEACHER_GRID
  CATEGORY_GRID
  STATISTICS
  TESTIMONIALS
  ANNOUNCEMENT
  VIDEO
  APP_DOWNLOAD
  BLOG
  FAQ
  LOGO_PARTNERS
  CTA
  CONTACT
  SOCIAL_LINKS
  CUSTOM_HTML
}

model HomePageSection {
  id             String          @id @default(cuid())
  type           HomeSectionType
  title          String?
  subtitle       String?
  order          Int
  visible        Boolean         @default(true)
  visibleDesktop Boolean         @default(true)
  visibleMobile  Boolean         @default(true)
  // Type-specific fields live here (e.g. hero heading/CTA/images for HERO,
  // { mode: "FEATURED"|"LATEST"|"MANUAL", courseIds, limit } for
  // COURSE_GRID). Deliberately not modeled as separate tables per type —
  // 20 section types with their own tables would be a much larger surface
  // for very little real benefit over one validated JSON column per row.
  config         Json            @default("{}")
  background     String?
  padding        String?
  createdById    String
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy User  @relation("HomeSectionCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("HomeSectionUpdatedBy", fields: [updatedById], references: [id])

  @@index([order])
  @@map("home_page_sections")
}

model HomePageVersion {
  id               String    @id @default(cuid())
  versionNumber    Int
  sectionsSnapshot Json
  note             String?
  publishedById    String
  publishedAt      DateTime  @default(now())
  // Set when an admin unpublishes — the public site then shows the
  // fallback homepage instead of this (or falls back to an even older
  // version only if a NEW publish happens; unpublish is a hard "go dark"
  // action on whatever is currently live, matching the spec's distinct
  // Publish/Unpublish buttons rather than silently reverting).
  unpublishedAt    DateTime?

  publishedBy User @relation(fields: [publishedById], references: [id])

  @@index([publishedAt])
  @@map("home_page_versions")
}

