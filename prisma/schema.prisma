model FooterColumn {
  id    String @id @default(cuid())
  title String
  order Int    @default(0)

  links FooterLink[]

  @@map("footer_columns")
}

model FooterLink {
  id         String  @id @default(cuid())
  columnId   String
  label      String
  url        String
  icon       String?
  openNewTab Boolean @default(false)
  order      Int     @default(0)

  column FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@map("footer_links")
}

// Singleton (always exactly one row, fetched with findFirst) for the parts
// of the footer that aren't columns of links — logo, blurb, contact info,
// social icons, app download buttons.
model FooterSettings {
  id               String   @id @default(cuid())
  logoUrl          String?
  description      String?
  copyrightText    String?
  contactPhone     String?
  contactEmail     String?
  address          String?
  socialLinks      Json?
  appDownloadLinks Json?
  updatedAt        DateTime @updatedAt

  @@map("footer_settings")
}

// Generic per-page SEO row, keyed by a human-readable page identifier.
// Only "home" is used today; the shape extends to future static pages
// without a schema change.
model PageSeo {
  id              String   @id @default(cuid())
  pageKey         String   @unique
  metaTitle       String?
  metaDescription String?
  keywords        String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  canonicalUrl    String?
  robotsDirective String?  @default("index,follow")
  updatedAt       DateTime @updatedAt

  @@map("page_seo")
}

// ==========================================================================
// MODULE STUDIO — imported as-is from Atomic Test Portal (PDF/brand-asset
// generation tool: upload a source PDF/module, OCR + layout-reconstruct it
// into editable elements, apply a BrandProfile, export a re-branded PDF).
// Genuinely unrelated to DPP/Question Bank/Test Series/AIR — kept fully
// separate from the Test Engine models above; nothing here is referenced
// by Test/Question/Dpp and nothing there is referenced by Module.
// ==========================================================================

model Module {
  id           String        @id @default(cuid())
  code         String        @unique
  title        String
  subject      String?
  class        String?
  batch        String?
  chapter      String?
  facultyName  String?
  academicYear String?
  status       ModuleStatus  @default(DRAFT)
  pdfType      ModulePdfType @default(UNKNOWN)

  originalFileUrl  String
  originalFileName String
  originalFileSize Int
  pageCount        Int?

  rightsConfirmedById String?
  rightsConfirmedAt   DateTime?
  reviewedById        String?
  reviewedAt          DateTime?

  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id])

  createdById String?
  createdBy   User?    @relation("ModuleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages          ModulePage[]
  assets         ModuleAsset[]
  versions       ModuleVersion[]
  processingJobs ProcessingJob[]
  exportHistory  ModuleExport[]

  @@map("modules")
}

model ModulePage {
  id                String        @id @default(cuid())
  moduleId          String
  pageNumber        Int
  width             Float
  height            Float
  pdfType           ModulePdfType @default(UNKNOWN)
  referenceImageUrl String?
  elements          Json          @default("[]")
  ocrConfidence     Float?
  needsReview       Boolean       @default(false)
  warnings          Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, pageNumber])
  @@map("module_pages")
}

model ModuleAsset {
  id         String   @id @default(cuid())
  moduleId   String
  storageUrl String
  mimeType   String
  width      Int?
  height     Int?
  sourcePage Int?
  createdAt  DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_assets")
}

model ModuleVersion {
  id          String   @id @default(cuid())
  moduleId    String
  label       String
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_versions")
}

model BrandProfile {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String?
  primaryColor    String?
  secondaryColor  String?
  fontFamily      String?
  websiteUrl      String?
  tagline         String?
  headerConfig    Json     @default("{}")
  footerConfig    Json     @default("{}")
  watermarkConfig Json     @default("{}")
  isDefault       Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())

  createdBy User?    @relation("BrandProfileCreatedBy", fields: [createdById], references: [id])
  modules   Module[]

  @@map("brand_profiles")
}

model ProcessingJob {
  id           String          @id @default(cuid())
  moduleId     String
  stage        ProcessingStage @default(UPLOADING)
  progress     Int             @default(0)
  errorMessage String?
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("processing_jobs")
}

model ModuleExport {
  id                String   @id @default(cuid())
  moduleId          String
  versionId         String?
  fileUrl           String
  fileName          String
  fileSize          Int
  quality           String   @default("STANDARD")
  includedFrontPage Boolean  @default(true)
  includedWatermark Boolean  @default(false)
  createdById       String?
  createdAt         DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_exports")
}

enum ModuleStatus {
  DRAFT
  PROCESSING
  REVIEW_REQUIRED
  READY
  PUBLISHED
  ARCHIVED
  FAILED
}

enum ModulePdfType {
  DIGITAL
  SCANNED
  HYBRID
  UNKNOWN
}

// Not referenced directly by any column (elements Json on ModulePage holds
// these tagged by "type"), kept as the canonical list the Module Studio UI
// and OCR/layout pipeline validate against.
enum ModuleElementType {
  TEXT
  HEADING
  SUBHEADING
  PARAGRAPH
  QUESTION
  OPTION
  SOLUTION
  IMAGE
  DIAGRAM
  EQUATION
  CHEMICAL_EQUATION
  CHEMICAL_STRUCTURE
  TABLE
  SHAPE
  LINE
  RECTANGLE
  CIRCLE
  ARROW
  TEXT_BOX
  PAGE_BACKGROUND
  HEADER
  FOOTER
  WATERMARK
  PAGE_NUMBER
}

enum ProcessingStage {
  UPLOADING
  ANALYZING
  EXTRACTING
  OCR_PROCESSING
  RECONSTRUCTING_LAYOUT
  GENERATING_PREVIEW
  READY_FOR_REVIEW
  FAILED
}

// =====================================================================
// AI Chat / Atomic Guru integration (imported from _import_atomic-ai-chat)
// =====================================================================
// Brought in "as is" as a parallel feature set per instruction, wired onto
// the EXISTING User above instead of the source app's own User/Account/
// Session table (see the comment on User for what was deliberately not
// duplicated). Three model names collided with existing atomic-ops models
// and were renamed to coexist: Course -> AiChatCourse, Batch -> AiChatBatch,
// Subscription -> AiChatSubscription (+ its SubscriptionStatus enum ->
// AiChatSubscriptionStatus). AuditLog was NOT duplicated — this app's audit
// events reuse the existing AuditLog model instead, same precedent as the
// Test Portal merge. All ids switched to cuid() defaults and a few
// createdAt/updatedAt fields gained DB-level defaults, matching the rest of
// this schema (the source app set them manually in application code).

enum AtomicBatch {
  SELECTION_PRO
  SELECTION_1_0
  ARAMBH
  MANZIL
  UDAAN
  NO_BATCH
}

enum AccessPlan {
  FREE
  BASIC
  PRO
  LIFETIME
}

enum AccessType {
  FREE_TRIAL
  BASIC_PLAN
  PRO_PLAN
  ATOMIC_BATCH_FREE
  LIFETIME_ACCESS
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum AttachmentKind {
  IMAGE
  PDF
  AUDIO
  DOCUMENT
}

enum StorageProvider {
  LOCAL
  SUPABASE
  S3
}

enum QuestionSource {
  AI_GENERATED
  ATOMIC_TEST_PORTAL
  MANUAL
}

enum AiChatSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

model UserProfile {
  id                  String      @id @default(cuid())
  userId              String      @unique
  phone               String?
  className           String?
  atomicBatch         AtomicBatch @default(NO_BATCH)
  target              String      @default("NEET")
  board               String?
  preferredLanguage   String      @default("hinglish")
  preferredTeachers   String[]    @default([])
  strongChapters      String[]    @default([])
  weakChapters        String[]    @default([])
  favoriteSubject     String?
  xp                  Int         @default(0)
  currentStreak       Int         @default(0)
  longestStreak       Int         @default(0)
  lastActiveDate      DateTime?
  learningPreferences Json?
  recentActivity      Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_chat_user_profiles")
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("system")
  language           String   @default("hinglish")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  privacyMode        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_chat_user_preferences")
}

model AiMemory {
  id           String   @id @default(cuid())
  userId       String   @unique
  facts        Json     @default("[]")
  studyContext Json?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_memory")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("ai_chat_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_chat_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("ai_chat_password_reset_tokens")
}

model AtomicIdSequence {
  id        String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("ai_chat_atomic_id_sequence")
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  title     String
  language  String        @default("hinglish")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("ai_chat_conversations")
}

model ChatMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String              @db.Text
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  metadata       Json?
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("ai_chat_messages")
}

model StoredFile {
  id            String              @id @default(cuid())
  ownerId       String
  provider      StorageProvider     @default(LOCAL)
  storageKey    String              @unique
  publicUrl     String?
  originalName  String
  mimeType      String
  size          Int
  checksum      String?
  extractedText String?             @db.Text
  createdAt     DateTime            @default(now())
  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageLinks  MessageAttachment[]

  @@index([ownerId, createdAt])
  @@map("ai_chat_stored_files")
}

model MessageAttachment {
  id            String         @id @default(cuid())
  messageId     String
  storedFileId  String?
  kind          AttachmentKind
  name          String
  mimeType      String
  size          Int
  url           String?
  extractedText String?        @db.Text
  message       ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storedFile    StoredFile?    @relation(fields: [storedFileId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([storedFileId])
  @@map("ai_chat_message_attachments")
}

model AiChatSubscription {
  id                   String                    @id @default(cuid())
  userId               String
  provider             String?
  providerCustomerId   String?
  providerPlanId       String?
  status               AiChatSubscriptionStatus  @default(TRIALING)
  plan                 AccessPlan                @default(BASIC)
  accessType           AccessType                @default(BASIC_PLAN)
  accessStatus         AccessStatus              @default(ACTIVE)
  grantedByUserId      String?
  grantedAt            DateTime                  @default(now())
  reason               String?                   @db.Text
  batchId              String?
  courseId             String?
  enrollmentId         String?
  externalEnrollmentId String?
  syncSource           String?
  metadata             Json?
  startsAt             DateTime                  @default(now())
  endsAt               DateTime?
  cancelAtPeriodEnd    Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation("AiChatSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy            User?                     @relation("AiChatSubscriptionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  batch                AiChatBatch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  course               AiChatCourse?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  enrollment           Enrollment?               @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  effectiveAccess      UserAccess?

  @@unique([provider, providerCustomerId])
  @@index([userId, status])
  @@index([userId, accessStatus, endsAt])
  @@index([batchId, accessStatus])
  @@index([courseId, accessStatus])
  @@index([externalEnrollmentId])
  @@map("ai_chat_subscriptions")
}

model UserAccess {
  id             String        @id @default(cuid())
  userId         String        @unique
  subscriptionId String?       @unique
  plan           AccessPlan    @default(FREE)
  accessType     AccessType    @default(FREE_TRIAL)
  status         AccessStatus  @default(EXPIRED)
  startsAt       DateTime?
  expiresAt      DateTime?
  batchId        String?
  courseId       String?
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   AiChatSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  batch          AiChatBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  course         AiChatCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, plan, expiresAt])
  @@index([batchId])
  @@index([courseId])
  @@map("ai_chat_user_access")
}

model AiChatCourse {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  description       String?           @db.Text
  isPublished       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  batches           AiChatBatch[]
  enrollments       Enrollment[]
  batchMemberships  BatchMembership[]
  testAttempts      TestAttempt[]
  subscriptions     AiChatSubscription[]
  accessRecords     UserAccess[]

  @@map("ai_chat_courses")
}

model AiChatBatch {
  id            String            @id @default(cuid())
  courseId      String
  title         String
  schedule      Json?
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  course        AiChatCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  memberships   BatchMembership[]
  subscriptions AiChatSubscription[]
  accessRecords UserAccess[]

  @@index([courseId])
  @@map("ai_chat_batches")
}

model Enrollment {
  id                   String            @id @default(cuid())
  userId               String
  courseId             String
  batchId              String?
  status               String            @default("ACTIVE")
  externalEnrollmentId String?
  syncSource           String            @default("manual")
  syncedAt             DateTime?
  enrolledAt           DateTime          @default(now())
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course               AiChatCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch                AiChatBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subscriptions        AiChatSubscription[]
  batchMemberships     BatchMembership[]

  @@unique([userId, courseId])
  @@unique([syncSource, externalEnrollmentId])
  @@index([batchId])
  @@map("ai_chat_enrollments")
}

model BatchMembership {
  id               String       @id @default(cuid())
  userId           String
  batchId          String
  courseId         String?
  enrollmentId     String?
  status           String       @default("ACTIVE")
  externalMemberId String?
  syncSource       String       @default("manual")
  syncedAt         DateTime?
  joinedAt         DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch            AiChatBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course           AiChatCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  enrollment       Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, batchId])
  @@unique([syncSource, externalMemberId])
  @@index([batchId, status])
  @@index([userId, status])
  @@index([courseId])
  @@map("ai_chat_batch_memberships")
}

// The AI Chat app's own lightweight per-user test log — separate from the
// Test Portal's Test/Section/Attempt system merged earlier; not unified
// with it to keep this import's own feature intact, per instruction.
model TestAttempt {
  id          String        @id @default(cuid())
  userId      String
  courseId    String?
  testName    String
  subject     String?
  score       Float?
  maxScore    Float?
  answers     Json?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      AiChatCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([courseId])
  @@map("ai_chat_test_attempts")
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@map("ai_chat_usage_events")
}

model GuestUsage {
  id          String   @id @default(cuid())
  guestId     String   @unique
  ip          String
  count       Int      @default(0)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([ip])
  @@map("ai_chat_guest_usage")
}

model ClassSchedule {
  id              String      @id @default(cuid())
  batch           AtomicBatch
  classDate       DateTime
  startTime       String
  endTime         String?
  subject         String
  teacherName     String?
  teacherPhotoUrl String?
  topic           String
  youtubeLink     String?
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([batch, classDate])
  @@map("ai_chat_class_schedules")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  subject        String
  topic          String?
  totalQuestions Int
  correct        Int
  wrong          Int
  unattempted    Int
  score          Int
  accuracy       Int
  timeTakenSec   Int?
  breakdown      Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, subject])
  @@map("ai_chat_quiz_attempts")
}

model AnswerReport {
  id             String        @id @default(cuid())
  userId         String?
  questionBankId String?
  questionText   String        @db.Text
  answerText     String        @db.Text
  reason         String?       @db.Text
  status         String        @default("OPEN")
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  question       QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([questionBankId])
  @@index([status])
  @@map("ai_chat_answer_reports")
}

model QuestionBank {
  id            String         @id @default(cuid())
  subject       String
  chapter       String?
  topic         String?
  text          String         @db.Text
  options       Json
  correctIndex  Int
  explanation   String         @db.Text
  difficulty    String?
  language      String         @default("english")
  source        QuestionSource @default(AI_GENERATED)
  contentHash   String         @unique
  externalRefId String?        @unique
  timesUsed     Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reports       AnswerReport[]

  @@index([subject, chapter, topic])
  @@index([source])
  @@map("ai_chat_question_bank")
}

// ============================================================
// ACADEMIC FOUNDATION & NCERT MASTER DATA
// ============================================================

enum ProgramName {
  NEET
  JEE_MAIN
  JEE_ADVANCED
  CBSE_BOARD
  FOUNDATION
}

model AcademicClass {
  id           String            @id @default(cuid())
  name         String            @unique // e.g. "Class 11", "Class 12"
  numericValue Int               @unique // 11, 12
  order        Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subjects     AcademicSubject[]
  programs     ProgramMapping[]

  @@map("academic_classes")
}

model AcademicSubject {
  id              String            @id @default(cuid())
  classId         String
  name            String // e.g. "Physics", "Chemistry", "Biology", "Mathematics"
  nameHindi       String? // e.g. "भौतिक विज्ञान", "रसायन विज्ञान", "जीव विज्ञान", "गणित"
  code            String? // e.g. "PHY-11", "CHE-11"
  order           Int               @default(0)
  isSystem        Boolean           @default(true) // true = Standard NCERT, false = Custom
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  academicClass   AcademicClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  books           AcademicBook[]
  chapters        AcademicChapter[]
  programMappings ProgramMapping[]

  @@unique([classId, name])
  @@index([classId])
  @@map("academic_subjects")
}

model AcademicBook {
  id          String            @id @default(cuid())
  subjectId   String
  title       String // e.g. "Physics Part I", "Chemistry Part I"
  titleHindi  String? // e.g. "भौतिकी भाग 1"
  partNumber  Int               @default(1)
  editionYear String?           @default("2024-25 Rationalised")
  isSystem    Boolean           @default(true)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  subject     AcademicSubject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters    AcademicChapter[]

  @@index([subjectId])
  @@map("academic_books")
}

model AcademicChapter {
  id              String             @id @default(cuid())
  subjectId       String
  bookId          String?
  chapterNumber   Int // e.g. 1, 2, 3 (NCERT chapter number)
  title           String // English title: "Units and Measurements"
  titleHindi      String? // Hindi title: "मात्रक और मापन"
  displayOrder    Int                @default(0)
  isSystem        Boolean            @default(true)
  isRationalised  Boolean            @default(true) // Current rationalised NCERT
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subject         AcademicSubject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  book            AcademicBook?      @relation(fields: [bookId], references: [id], onDelete: SetNull)
  topics          AcademicTopic[]
  programMappings ProgramMapping[]

  @@unique([subjectId, chapterNumber])
  @@index([subjectId])
  @@index([bookId])
  @@map("academic_chapters")
}

model AcademicTopic {
  id              String             @id @default(cuid())
  chapterId       String
  topicNumber     String // e.g. "1.1", "1.2", "2.1" (official NCERT section numbering)
  title           String // English title
  titleHindi      String? // Hindi title
  displayOrder    Int                @default(0)
  isSystem        Boolean            @default(true)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  chapter         AcademicChapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subtopics       AcademicSubtopic[]
  programMappings ProgramMapping[]

  @@unique([chapterId, topicNumber, title])
  @@index([chapterId])
  @@map("academic_topics")
}

model AcademicSubtopic {
  id             String        @id @default(cuid())
  topicId        String
  subtopicNumber String? // e.g. "1.1.1", "2.3.1"
  title          String
  titleHindi     String?
  displayOrder   Int           @default(0)
  isSystem       Boolean       @default(true)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  topic          AcademicTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("academic_subtopics")
}

model ProgramMapping {
  id          String           @id @default(cuid())
  programName ProgramName
  classId     String
  subjectId   String
  chapterId   String
  topicId     String?
  weightage   Float? // Estimated exam weightage percentage
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  class       AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     AcademicSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter     AcademicChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topic       AcademicTopic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([programName, chapterId, topicId])
  @@index([programName])
  @@index([classId])
  @@index([subjectId])
  @@index([chapterId])
  @@map("academic_program_mappings")
}

model PlatformResource {
  id            String    @id @default(cuid())
  resourceId    String    @unique // e.g. LEC-89104, TST-39102, DPP-10923, QST-77182, PDF-50912
  type          String // LECTURE | VIDEO | TEST | DPP | QUESTION | PDF | MODULE
  title         String
  subject       String?
  targetId      String // ID of the underlying model
  downloadUrl   String?
  format        String? // PDF | MP4 | ZIP | JSON
  sizeBytes     Int?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedById   String?
  deletedReason String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy     User?     @relation("PlatformResourceCreatedBy", fields: [createdById], references: [id])
  deletedBy     User?     @relation("PlatformResourceDeletedBy", fields: [deletedById], references: [id])
  auditLogs     ResourceAuditLog[]

  @@index([resourceId])
  @@index([type])
  @@index([targetId])
  @@index([isDeleted])
  @@map("platform_resources")
}

model ResourceAuditLog {
  id           String   @id @default(cuid())
  resourceId   String
  resourceType String
  userId       String
  userName     String?
  action       String // DOWNLOAD | DELETE | ATTEMPT_BLOCKED | RESTORE
  result       String // SUCCESS | PERMISSION_DENIED | FAILED
  reason       String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  resource     PlatformResource? @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([userId])
  @@index([action])
  @@map("resource_audit_logs")
}

model RevisionItem {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // CLASS | SUBJECT | CHAPTER | TOPIC | SUBTOPIC
  entityId   String
  title      String
  fullPath   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions RevisionSession[]

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([active])
  @@map("revision_items")
}

model RevisionSession {
  id             String    @id @default(cuid())
  userId         String
  revisionItemId String
  revisionNumber Int
  mode           String    @default("ALL") // ALL | UNATTEMPTED | PREVIOUSLY_INCORRECT | WEAK | RANDOM
  totalQuestions Int
  attempted      Int       @default(0)
  correct        Int       @default(0)
  incorrect      Int       @default(0)
  skipped        Int       @default(0)
  accuracy       Float     @default(0.0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  revisionItem RevisionItem               @relation(fields: [revisionItemId], references: [id], onDelete: Cascade)
  attempts     RevisionQuestionAttempt[]

  @@index([userId])
  @@index([revisionItemId])
  @@map("revision_sessions")
}

model RevisionQuestionAttempt {
  id          String   @id @default(cuid())
  sessionId   String
  questionId  String
  isCorrect   Boolean
  userAnswer  String?
  attemptedAt DateTime @default(now())

  session  RevisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@map("revision_question_attempts")
}

model RevisionNodeSeen {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  seenAt     DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("revision_nodes_seen")
}

// ============================================================
// HIGH-PRECISION QUESTION EXTRACTION & INGESTION MODULE
// ============================================================

model ExtractionJob {
  id              String   @id @default(cuid())
  sourceName      String   // e.g. "ALLEN", "RACE", "NCERT", "NEET 2025", "AIIMS"
  fileName        String
  fileUrl         String
  fileSize        Int      @default(0)
  startNumber     Int      @default(1)
  endNumber       Int      @default(180)
  expectedCount   Int      @default(180)
  extractedCount  Int      @default(0)
  verifiedCount   Int      @default(0)
  reviewCount     Int      @default(0)
  errorCount      Int      @default(0)
  missingCount    Int      @default(0)
  duplicateCount  Int      @default(0)
  status          String   @default("PENDING") // PENDING, PROCESSING, REVIEW_REQUIRED, VERIFIED, IMPORTED, FAILED
  progress        Int      @default(0) // 0 - 100
  currentStep     String?  // e.g. "Detecting Questions...", "Extracting Tables...", "Validating Answer Keys..."
  reportJson      Json?    // Detailed Validation Report, issue list, and count reconciliation
  examName        String?
  year            String?
  subject         String?  // Configured or Auto-detected
  chapter         String?
  tags            String[] @default([])
  createdById     String
  createdBy       User     @relation("ExtractionJobCreatedBy", fields: [createdById], references: [id])
  questions       ExtractedQuestion[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceName])
  @@index([status])
  @@index([createdById])
  @@map("extraction_jobs")
}

model ExtractedQuestion {
  id                   String        @id @default(cuid())
  jobId                String
  job                  ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questionIndex        Int           // Sequence index (1, 2, 3...)
  originalNumber       Int           // Exact printed number in source (e.g. 37)
  sourceName           String        // Permanent source (e.g. "ALLEN")
  sourcePdfUrl         String
  sourcePdfName        String
  sourcePage           Int           @default(1)
  statement            String        // Exact text with LaTeX & symbols
  statementHi          String?
  options              Json          // { A: "...", B: "...", C: "...", D: "..." }
  correctAnswer        String        @default("A") // "A" | "B" | "C" | "D"
  answerKeySource      String?       // "ANSWER_KEY_SECTION" | "INFERRED_REVIEW" | "MANUAL"
  solution             String?       // Original extracted step-by-step solution
  solutionHi           String?
  hasTable             Boolean       @default(false)
  tablesJson           Json?         // Structured markdown or matrix
  hasImage             Boolean       @default(false)
  imagesJson           Json?         // Extracted image objects & coordinates
  imageUrl             String?       // Extracted reference diagram
  hasEquation          Boolean       @default(false)
  subject              String        @default("General")
  chapter              String?
  topic                String?
  subTopic             String?
  questionType         String        @default("SINGLE_CORRECT") // One of the 18 NEET types
  difficulty           String        @default("MEDIUM") // EASY, MEDIUM, HARD, VERY_HARD
  status               String        @default("VERIFIED") // VERIFIED, REVIEW_REQUIRED, EXTRACTION_ERROR, MISSING, DUPLICATE, IMPORTED
  confidence           Float         @default(95.0)
  confidenceBreakdown  Json?         // { text: 99.8, options: 99.9, table: 98.4, image: 100, answer: 100, solution: 99.7 }
  reviewReasons        Json?         // String[] of review reasons
  originalSnapshot     Json          // Immutable initial extraction snapshot
  isEdited             Boolean       @default(false)
  draftQuestionId      String?       // Linked Question Bank ID when moved to Draft
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([sourceName])
  @@index([originalNumber])
  @@map("extracted_questions")
}

// ==========================================================================
// MEDIA, LIVE CLASS, R2 ASSET & CHAT INFRASTRUCTURE MODELS
// ==========================================================================

model FileAsset {
  id               String   @id @default(uuid())
  ownerId          String
  fileType         String   // PDF, IMAGE, DOCUMENT, DPP, NOTES, WHITEBOARD_SNAPSHOT, PROFILE_IMAGE, THUMBNAIL
  storageProvider  String   @default("r2")
  bucket           String   @default("atomic-pathshala")
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt   @default(0)
  status           String   @default("ACTIVE") // PENDING_UPLOAD, ACTIVE, DELETED
  visibility       String   @default("PROTECTED") // PUBLIC, PROTECTED, PRIVATE
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@index([fileType])
  @@index([status])
  @@index([visibility])
  @@map("file_assets")
}

model VideoAsset {
  id               String   @id @default(uuid())
  lectureId        String?
  liveClassId      String?
  provider         String   @default("publitio") // publitio, bunny, youtube
  providerVideoId  String
  status           String   @default("READY") // UPLOADING, PROCESSING, READY, FAILED
  durationSeconds  Int?
  thumbnailUrl     String?
  hlsUrl           String?
  mp4Url           String?
  playbackMetadata Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lectureId])
  @@index([liveClassId])
  @@index([provider])
  @@index([status])
  @@map("video_assets")
}

model LiveClass {
  id                 String    @id @default(uuid())
  lectureId          String?
  batchScheduleId    String?   @unique
  roomName           String    @unique // e.g. atomic-live-<UUID>
  teacherId          String
  status             String    @default("SCHEDULED") // SCHEDULED, LIVE, ENDED, RECORDING_PROCESSING, PUBLISHED
  classType          String    @default("APP_LIVE") // APP_LIVE, YOUTUBE, RECORDED_APP
  youtubeVideoId     String?
  scheduledStart     DateTime
  scheduledEnd       DateTime
  actualStart        DateTime?
  actualEnd          DateTime?
  recordingStatus    String    @default("NONE") // NONE, RECORDING, PROCESSING, AVAILABLE, FAILED
  recordingVideoId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([classType])
  @@index([scheduledStart])
  @@map("live_classes")
}

model WhiteboardSnapshot {
  id           String   @id @default(uuid())
  liveClassId  String
  r2FileId     String
  snapshotType String   @default("FINAL") // PERIODIC, FINAL
  pageCount    Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([liveClassId])
  @@index([r2FileId])
  @@map("whiteboard_snapshots")
}

model LiveChatMessage {
  id             String    @id @default(uuid())
  liveClassId    String
  userId         String
  authorName     String
  authorRole     String    @default("STUDENT")
  message        String
  isAnnouncement Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([liveClassId])
  @@index([userId])
  @@index([createdAt])
  @@map("live_chat_messages")
}
