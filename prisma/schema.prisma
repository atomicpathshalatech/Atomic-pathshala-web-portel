  whiteboardSessionId String?
  sourceMessageId     String?
  resolvedBy          User?              @relation("DoubtResolvedBy", fields: [resolvedById], references: [id])
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  whiteboardSession   WhiteboardSession? @relation(fields: [whiteboardSessionId], references: [id], onDelete: SetNull)
  sourceMessage       WhiteboardMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

