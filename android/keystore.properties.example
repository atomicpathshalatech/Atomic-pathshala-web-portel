# Keystore signing configuration for Atomic Pathshala Release Builds
# Copy this file to `android/keystore.properties` and fill in your private key values.
# NEVER commit `keystore.properties` or `*.jks` files to git!

storeFile=../atomic-release-key.jks
storePassword=YOUR_KEYSTORE_STORE_PASSWORD
keyAlias=atomicpathshala
keyPassword=YOUR_KEY_PASSWORD
