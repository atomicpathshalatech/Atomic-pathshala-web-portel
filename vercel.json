      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/youtube-archive/process",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/whiteboard-youtube-recording/process",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/cron/youtube-video-stats",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/cron/whatsapp/digest",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/whatsapp/reminders",
