# --- Supabase Database & Auth ---------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth.js / NextAuth ---------------------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# --- Cloudflare R2 Object Storage (Documents, PDFs, DPPs, Snapshots) ------
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="atomic-pathshala"
R2_PUBLIC_BASE_URL="https://assets.atomicpathshala.com"

# Fallback compatibility S3 variables
STORAGE_PROVIDER="cloudflare-r2"
STORAGE_BUCKET_NAME="atomic-pathshala"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# --- LiveKit Interactive SFU Classroom Video ------------------------------
LIVEKIT_URL="wss://atomic-pathshala.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://atomic-pathshala.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- Publitio Recorded Video Testing & Hosting ----------------------------
