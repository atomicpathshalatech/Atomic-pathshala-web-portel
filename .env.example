# ==========================================================================
# ATOMIC PATHSHALA ENTERPRISE — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================================

# --- Database (Neon or Supabase PostgreSQL — free/low tier to start) ------
DATABASE_URL="postgresql://user:password@host:5432/atomic_pathshala?sslmode=require"

# --- Auth.js ----------------------------------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloud Object Storage (choose one low-cost provider) --------------------
STORAGE_PROVIDER="cloudflare-r2" # or "supabase-storage"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# --- Payments (Razorpay per locked spec) -------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Realtime (Pusher — free tier: 200k messages/day, 100 max concurrent
#     connections, enough to pilot live classes; upgrade if a batch exceeds
#     that concurrently). Get these from dashboard.pusher.com -> Channels app
#     -> App Keys. -------------------------------------------------------------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# --- Video calling (LiveKit — managed SFU, same "hosted service" pattern as
#     Neon/Razorpay/Pusher above, not a self-run media server). Free tier:
#     LiveKit Cloud gives ~50 monthly active participants / a few thousand
#     connection-minutes free, enough to pilot; upgrade before real scale.
#     Get these from cloud.livekit.io -> your project -> Settings -> Keys.
#     NEXT_PUBLIC_LIVEKIT_URL is the project's wss:// URL, safe to expose
#     (same category as NEXT_PUBLIC_PUSHER_KEY above) — it identifies which
#     server to connect to, it isn't a credential. ----------------------------
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

# --- Outreach CRM integration (atomic-outreach-system) -----------------------
# OUTREACH_API_KEY: shared secret the CRM sends as the `x-api-key` header on
#   its server-to-server calls (course/batch list, lead-invite-link
#   creation) — generate with `openssl rand -hex 32`, set the SAME value in
#   the outreach-system's own .env.
# LEAD_INVITE_SECRET: signs the "Convert to LMS" magic registration links —
#   generate separately, `openssl rand -base64 32`. Only atomic-ops needs
#   this one; it never leaves this app.
# OUTREACH_APP_URL: base URL of the outreach-system app — used to call back
#   its /api/webhooks/lms-conversion once a CRM-invited lead finishes
#   registering, so the CRM can mark that lead CONVERTED for real. Leave
#   unset in dev if you don't have that app running; the webhook call is
#   skipped (logged, not fatal) when it's missing.
OUTREACH_API_KEY=""
LEAD_INVITE_SECRET=""
OUTREACH_APP_URL="http://localhost:3005"

# --- App -----------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- AI Chat / Atomic Guru (imported from _import_atomic-ai-chat) --------
# GEMINI_API_KEY: Google AI Studio API key for Gemini — required for the
#   chat/quiz/board-exam features under /guru to work at all. Get one at
#   https://aistudio.google.com/apikey.
# GEMINI_API_KEYS: optional comma-separated list of additional Gemini keys
#   for load-balancing/fallback across quota limits; leave unset to just
#   use GEMINI_API_KEY alone.
# GOOGLE_SHEET_ID / GOOGLE_SERVICE_ACCOUNT_JSON / GOOGLE_SCHEDULE_SHEET_RANGE:
#   only needed if you want the admin class-schedule "Sync from Sheet"
#   feature (/guru/admin/schedule). GOOGLE_SHEET_ID is the sheet's ID from
#   its URL; GOOGLE_SERVICE_ACCOUNT_JSON is the *contents* of a Google
#   service-account key (paste the whole JSON as one line) — do NOT save a
#   service-account.json file in this project; it is gitignored and this
#   integration never reads one. GOOGLE_SCHEDULE_SHEET_RANGE defaults to
#   "Schedule!A:P" if unset. Leave all three unset to skip Sheets sync
#   entirely — everything else under /guru works fine without it.
GEMINI_API_KEY=""
GEMINI_API_KEYS=""
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SCHEDULE_SHEET_RANGE=""
