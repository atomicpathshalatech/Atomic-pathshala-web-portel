# ==========================================================================
# ATOMIC PATHSHALA — COMPLETE ENTERPRISE & MEDIA INFRASTRUCTURE CONFIGURATION
# Copy to .env and fill in real values. Never commit .env to version control.
# ==========================================================================

# --- Supabase Database ---------------------------------------------------
# Project region MUST be ap-south-1 (Mumbai) to sit in the same region as the
# Vercel functions (vercel.json -> "bom1"). See docs/DB_MUMBAI_MIGRATION.md.
#
# DATABASE_URL -> the TRANSACTION POOLER (port 6543). Required for serverless:
#   Prisma opens a fresh connection per invocation and the pooler multiplexes
#   them. `pgbouncer=true` disables prepared statements; `connection_limit=1`
#   is the Prisma-recommended value behind a transaction pooler.
# DIRECT_URL   -> the DIRECT connection (port 5432). Used only by
#   `prisma migrate` / `prisma db push`, never at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Legacy Supabase-JS keys. The app talks to Postgres only through Prisma
# (server-side) — there is no @supabase/supabase-js client anywhere in src —
# so these are unused today. Keep them in sync with the active project anyway.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# --- Auth.js / NextAuth ---------------------------------------------------
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Public origin used to build links inside emails (staff invitations,
# password reset). MUST be set in every deployed environment or those links
# point at the fallback domain. Production: https://ap.atomicpathshala.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Transactional email (Resend) ---------------------------------------
# Without RESEND_API_KEY, sendMail() is a no-op: staff-invitation and
# password-reset emails are NOT sent (the invite link is still shown in the
# admin UI). Get the key from https://resend.com > API Keys.
RESEND_API_KEY=""
# The From address. Its domain MUST be verified in Resend (SPF/DKIM DNS
# records), otherwise Resend rejects every send with HTTP 403.
MAIL_FROM="Atomic Pathshala <noreply@atomicpathshala.in>"

# --- Cloudflare R2 Object Storage (Documents, PDFs, DPPs, Snapshots) ------
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="atomic-pathshala"
R2_PUBLIC_BASE_URL="https://assets.atomicpathshala.com"

# Fallback compatibility S3 variables
STORAGE_PROVIDER="cloudflare-r2"
STORAGE_BUCKET_NAME="atomic-pathshala"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# --- LiveKit Interactive SFU Classroom Video ------------------------------
LIVEKIT_URL="wss://atomic-pathshala.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://atomic-pathshala.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# --- Publitio Recorded Video Testing & Hosting ----------------------------
PUBLITIO_API_KEY="your_publitio_api_key"
PUBLITIO_API_SECRET="your_publitio_api_secret"
PUBLITIO_PUBLIC_URL_PREFIX="https://media.publit.io/file"
VIDEO_PROVIDER="publitio" # "publitio" | "bunny" | "youtube"

# --- Payments (Razorpay) --------------------------------------------------
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_public_key"

# --- Realtime (Pusher / Supabase Realtime) --------------------------------
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_public_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# --- Outreach CRM Integration ---------------------------------------------
OUTREACH_API_KEY="your_outreach_api_key"
LEAD_INVITE_SECRET="your_lead_invite_secret"
OUTREACH_APP_URL="http://localhost:3005"

# --- AI Chat / Atomic Guru (Gemini AI Studio) -----------------------------
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"

# --- SMS / OTP (MSG91) -----------------------------------------------------
# India requires DLT: the message body must come from a template registered
# on the DLT portal and approved for your entity, so the OTP text lives in
# MSG91, not in this codebase. Only the code + expiry are sent to the API.
#
# Setup (MSG91 dashboard):
#   1. Sender ID (DLT-approved header, 6 letters) must exist first.
#   2. OTP -> Templates -> Add template, body must contain ##OTP##, e.g.
#      "##OTP## is your Atomic Pathshala verification code. Valid for 5
#       minutes. Do not share it."
#   3. Copy the template ID shown after approval into MSG91_OTP_TEMPLATE_ID.
MSG91_AUTHKEY="your_msg91_authkey"
MSG91_OTP_TEMPLATE_ID="your_msg91_otp_template_id"

# --- MSG91 OTP Widget (student sign-up phone verification) ----------------
# Registration uses MSG91's hosted OTP Widget: the browser runs the widget
# (send/enter/verify UI), it returns a signed access token, and
# /api/auth/otp/verify-widget confirms that token with MSG91.
#   NEXT_PUBLIC_MSG91_WIDGET_ID    — widget id (Client Side Integration screen)
#   NEXT_PUBLIC_MSG91_WIDGET_TOKEN — the "tokenAuth" token (Tokens section)
#   MSG91_WIDGET_AUTHKEY           — account authkey (Server Side Integration
#                                    → "Get Authkey"); server-only.
NEXT_PUBLIC_MSG91_WIDGET_ID="your_msg91_widget_id"
NEXT_PUBLIC_MSG91_WIDGET_TOKEN="your_msg91_widget_token"
MSG91_WIDGET_AUTHKEY="your_msg91_authkey"

# Optional: only needed for generic (non-OTP) transactional SMS via the Flow
# API. Requires its own DLT-approved template with a single ##var## slot.
# MSG91_FLOW_TEMPLATE_ID="your_msg91_flow_template_id"

# Optional fallback gateway (used only when MSG91_AUTHKEY is unset).
# TWILIO_ACCOUNT_SID="your_twilio_sid"
# TWILIO_AUTH_TOKEN="your_twilio_token"
# TWILIO_FROM="+1XXXXXXXXXX"

# Dev only: echo the OTP in the send-API response instead of relying on a
# real SMS, so the signup/reset flow can be tested without spending credits.
# Force-disabled when NODE_ENV=production.
OTP_DEBUG_RETURN="0"
