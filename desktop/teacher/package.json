{
  "name": "atomic-teacher-desktop",
  "productName": "Atomic Pathshala",
  "version": "0.2.3",
  "private": true,
  "description": "Atomic Pathshala Windows app for students and the team: opens the portal of whoever signs in, plus the teachers' built-in YouTube encoder.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "test:encoder": "node scripts/test-encoder.mjs",
    "test:e2e": "node scripts/test-desktop-e2e.mjs",
    "predist": "node scripts/fetch-ffmpeg.mjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "in.atomicpathshala.teacher",
    "productName": "Atomic Pathshala",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Atomic Pathshala",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE.txt",
          "SOURCE.txt"
        ]
      }
    ],
    "artifactName": "Atomic-Pathshala-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-dfdc1ecb5e9b4183a8dc9ac9cc695380.r2.dev/desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
